## Original Query: SELECT like('Spark', '_park');
## PySpark 3.5.5 Result: {'Spark LIKE _park': True, 'typeof(Spark LIKE _park)': 'boolean', 'typeof(Spark)': 'string', 'typeof(_park)': 'string'}
query B
SELECT like(CAST('Spark' AS string), CAST('_park' AS string));
----
true

query B
SELECT ilike('Spark',  arrow_cast('_park', 'LargeUtf8'));
----
true

query B
SELECT ilike(CAST('Spark' AS STRING),  arrow_cast('_park', 'LargeUtf8'));
----
true

query B
SELECT like(CAST('Spark' AS string), CAST('_Park' AS string));
----
false

query B
SELECT like(CAST('SPARK' AS string), CAST('_park' AS string));
----
false

query B
SELECT like(CAST('Spark' AS string), CAST('Sp%' AS string));
----
true

query B
SELECT like(CAST('Spark' AS string), CAST('SP%' AS string));
----
false

query B
SELECT like(CAST('Spark' AS string), CAST('%ark' AS string));
----
true

query B
SELECT like(CAST('Spark' AS string), CAST('%ARK' AS string));
----
false

query B
SELECT like(CAST('Spark' AS string), CAST('xyz' AS string));
----
false

query B
SELECT like(CAST(NULL AS string), CAST('_park' AS string));
----
NULL

query B
SELECT like(CAST('Spark' AS string), CAST(NULL AS string));
----
NULL
