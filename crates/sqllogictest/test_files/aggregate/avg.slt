query R
SELECT avg(a) FROM (VALUES (CAST(10 AS INT)), (CAST(20 AS INT)), (CAST(30 AS INT)), (CAST(40 AS INT)), (CAST(50 AS INT))) AS t(a);
----
30

query R
SELECT avg(a) FROM (VALUES (CAST(40 AS INT)), (CAST(23 AS INT)), (CAST(17 AS INT)), (CAST(40 AS INT)), (NULL)) AS t(a);
----
30

query R
SELECT avg(a) FROM (VALUES (CAST(0 AS INT)), (CAST(0 AS INT))) AS t(a);
----
0

query IR
SELECT a % 2 AS g, avg(a)
FROM (VALUES (40), (23), (17), (40), (30)) AS t(a)
GROUP BY g
ORDER BY g;
----
0 36.666666666666664
1 20

query IR
SELECT a % 2 AS g, avg(a)
FROM (VALUES (CAST(10 AS INT)), (CAST(20 AS INT)), (CAST(30 AS INT)), (CAST(40 AS INT)), (CAST(50 AS INT))) AS t(a)
GROUP BY g
ORDER BY g;
----
0 30

query IR
SELECT a, avg(a)
FROM (VALUES (CAST(0 AS INT)), (CAST(0 AS INT))) AS t(a)
GROUP BY a
ORDER BY a;
----
0 0

# avg ignores ORDER BY, so the ORDER BY column must not reach its accumulators
query IR
SELECT a % 2 AS g, avg(a ORDER BY b)
FROM (VALUES (40, 1), (23, 2), (17, 3), (40, 4), (30, 5)) AS t(a, b)
GROUP BY g
ORDER BY g;
----
0 36.666666666666664
1 20

# DECIMAL input is cast to DOUBLE. Spark returns 1.500000 as DECIMAL(14, 6) (https://github.com/apache/datafusion-spark/issues/111)
query TR
SELECT arrow_typeof(avg(a)), avg(a) FROM (VALUES (CAST(1.00 AS DECIMAL(10, 2))), (CAST(2.00 AS DECIMAL(10, 2)))) AS t(a);
----
Float64 1.5
