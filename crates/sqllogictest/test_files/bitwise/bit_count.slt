## Original Query: SELECT bit_count(0);
## PySpark 3.5.5 Result: {'bit_count(0)': 0, 'typeof(bit_count(0))': 'int', 'typeof(0)': 'int'}

# Basic tests with different integer types
query I
SELECT bit_count(CAST(0 AS int));
----
0

query I
SELECT bit_count(CAST(1 AS int));
----
1

query I
SELECT bit_count(CAST(7 AS int));
----
3

query I
SELECT bit_count(CAST(15 AS int));
----
4

query I
SELECT bit_count(CAST(255 AS int));
----
8

query I
SELECT bit_count(CAST(1023 AS int));
----
10

# Tests with negative numbers (two's complement)
query I
SELECT bit_count(-CAST(1 AS int));
----
64

query I
SELECT bit_count(-CAST(2 AS int));
----
63

query I
SELECT bit_count(-CAST(3 AS int));
----
63

# Tests with different integer types
query I
SELECT bit_count(CAST(0 AS TINYINT));
----
0

query I
SELECT bit_count(CAST(15 AS TINYINT));
----
4

query I
SELECT bit_count(CAST(-1 AS TINYINT));
----
64

query I
SELECT bit_count(CAST(0 AS SMALLINT));
----
0

query I
SELECT bit_count(CAST(255 AS SMALLINT));
----
8

query I
SELECT bit_count(CAST(-1 AS SMALLINT));
----
64

query I
SELECT bit_count(CAST(0 AS BIGINT));
----
0

query I
SELECT bit_count(CAST(255 AS BIGINT));
----
8

query I
SELECT bit_count(CAST(-1 AS BIGINT));
----
64

# Tests with unsigned integer types
query I
SELECT bit_count(arrow_cast(0, 'UInt8'));
----
0

query I
SELECT bit_count(arrow_cast(255, 'UInt8'));
----
8

query I
SELECT bit_count(arrow_cast(0, 'UInt16'));
----
0

query I
SELECT bit_count(arrow_cast(65535, 'UInt16'));
----
16

query I
SELECT bit_count(arrow_cast(0, 'UInt32'));
----
0

query I
SELECT bit_count(arrow_cast(4294967295, 'UInt32'));
----
32

query I
SELECT bit_count(arrow_cast(0, 'UInt64'));
----
0

query I
SELECT bit_count(arrow_cast(18446744073709551615, 'UInt64'));
----
64

# Tests with NULL values
query I
SELECT bit_count(CAST(NULL AS INT));
----
NULL

query I
SELECT bit_count(CAST(NULL AS TINYINT));
----
NULL

query I
SELECT bit_count(arrow_cast(NULL, 'UInt64'));
----
NULL

# Tests with edge cases
query I
SELECT bit_count(CAST(0 AS INT)) as zero_count;
----
0

query I
SELECT bit_count(CAST(1 AS INT)) as one_count;
----
1

query I
SELECT bit_count(CAST(2 AS INT)) as two_count;
----
1

query I
SELECT bit_count(CAST(3 AS INT)) as three_count;
----
2

query I
SELECT bit_count(CAST(4 AS INT)) as four_count;
----
1

query I
SELECT bit_count(CAST(5 AS INT)) as five_count;
----
2

# Tests with large numbers
query I
SELECT bit_count(CAST(2147483647 AS INT));
----
31

query I
SELECT bit_count(CAST(-2147483648 AS INT));
----
33

query I
SELECT bit_count(CAST(9223372036854775807 AS BIGINT));
----
63

query I
SELECT bit_count(CAST(-9223372036854775808 AS BIGINT));
----
1

query I
SELECT bit_count(true);
----
1

query I
SELECT bit_count(false);
----
0

query I
SELECT bit_count(cast(null as boolean));
----
NULL
