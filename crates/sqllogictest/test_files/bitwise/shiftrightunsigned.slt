## Original Query: SELECT shiftrightunsigned(4, 1);
## PySpark 3.5.5 Result: {'shiftrightunsigned(4, 1)': 2, 'typeof(shiftrightunsigned(4, 1))': 'int', 'typeof(4)': 'int', 'typeof(1)': 'int'}

# Basic shiftrightunsigned tests
query I
SELECT shiftrightunsigned(CAST(4 AS int), CAST(1 AS int));
----
2

query I
SELECT shiftrightunsigned(CAST(8 AS int), CAST(2 AS int));
----
2

query I
SELECT shiftrightunsigned(CAST(16 AS int), CAST(3 AS int));
----
2

# Different data types
query I
SELECT shiftrightunsigned(CAST(4 AS bigint), CAST(1 AS int));
----
2

query I
SELECT shiftrightunsigned(CAST(8 AS bigint), CAST(2 AS int));
----
2

query I
SELECT shiftrightunsigned(CAST(4 AS int), CAST(1 AS bigint));
----
2

# Large shifts (should handle modulo correctly)
query I
SELECT shiftrightunsigned(CAST(1 AS int), CAST(32 AS int));
----
1

query I
SELECT shiftrightunsigned(CAST(2 AS int), CAST(33 AS int));
----
1

query I
SELECT shiftrightunsigned(CAST(3 AS int), CAST(64 AS int));
----
3

# Negative shifts
query I
SELECT shiftrightunsigned(CAST(4 AS int), -CAST(1 AS int));
----
0

query I
SELECT shiftrightunsigned(CAST(8 AS int), -CAST(2 AS int));
----
0

query I
SELECT shiftrightunsigned(CAST(16 AS int), -CAST(3 AS int));
----
0

# Zero shifts
query I
SELECT shiftrightunsigned(CAST(5 AS int), CAST(0 AS int));
----
5

query I
SELECT shiftrightunsigned(CAST(0 AS int), CAST(5 AS int));
----
0

# Edge cases - unsigned right shift treats negative values as large positive
query I
SELECT shiftrightunsigned(-CAST(4 AS int), CAST(1 AS int));
----
2147483646

query I
SELECT shiftrightunsigned(-CAST(8 AS int), CAST(2 AS int));
----
1073741822

query I
SELECT shiftrightunsigned(-CAST(16 AS int), CAST(3 AS int));
----
536870910

query I
SELECT shiftrightunsigned(CAST(2147483647 AS int), CAST(1 AS int));
----
1073741823


# Null handling
query I
SELECT shiftrightunsigned(CAST(NULL AS int), CAST(1 AS int));
----
NULL

query I
SELECT shiftrightunsigned(CAST(1 AS int), CAST(NULL AS int));
----
NULL

query I
SELECT shiftrightunsigned(CAST(NULL AS int), CAST(NULL AS int));
----
NULL

query I
select shiftrightunsigned(CAST(3 AS int),-31);
----
1

query I
select shiftrightunsigned(CAST(3 AS int),-32);
----
3

# i32 + nulls
query IT
SELECT
	shiftrightunsigned(CAST(value AS INT), shift),
	arrow_typeof(shiftrightunsigned(CAST(value AS INT), shift))
FROM VALUES
(4, 1),
(8, 2),
(16, 3),
(32, 4),
(null, 2),
(8, null)
t(value, shift)
----
2 Int32
2 Int32
2 Int32
2 Int32
NULL Int32
NULL Int32

# negative shift
query IT
SELECT
	shiftrightunsigned(CAST(value AS INT), shift),
	arrow_typeof(shiftrightunsigned(CAST(value AS INT), shift))
FROM VALUES
(4, -1),
(8, -2),
(16, -3)
t(value, shift)
----
0 Int32
0 Int32
0 Int32

# Negative values are treated as large positive values
# -4 as u32 = 4294967292, 4294967292 >>> 1 = 2147483646
# -8 as u32 = 4294967288, 4294967288 >>> 2 = 1073741822
# -16 as u32 = 4294967280, 4294967280 >>> 3 = 536870910
query IT
SELECT
	shiftrightunsigned(CAST(value AS INT), shift),
	arrow_typeof(shiftrightunsigned(CAST(value AS INT), shift))
FROM VALUES
(-4, 1),
(-8, 2),
(-16, 3)
t(value, shift)
----
2147483646 Int32
1073741822 Int32
536870910 Int32

# i64 value
query IT
SELECT
	shiftrightunsigned(CAST(value AS BIGINT), shift),
	arrow_typeof(shiftrightunsigned(CAST(value AS BIGINT), shift))
FROM VALUES (4, 1), (8, 2), (16, 3) t(value, shift)
----
2 Int64
2 Int64
2 Int64

# u32 value
query IT
SELECT
	shiftrightunsigned(arrow_cast(value, 'UInt32'), shift),
	arrow_typeof(shiftrightunsigned(arrow_cast(value, 'UInt32'), shift))
FROM VALUES (4, 1), (8, 2), (16, 3) t(value, shift)
----
2 UInt32
2 UInt32
2 UInt32

# u64 value
query IT
SELECT
	shiftrightunsigned(arrow_cast(value, 'UInt64'), shift),
	arrow_typeof(shiftrightunsigned(arrow_cast(value, 'UInt64'), shift))
FROM VALUES (4, 1), (8, 2), (16, 3) t(value, shift)
----
2 UInt64
2 UInt64
2 UInt64

# pure null handling
query IT
SELECT shiftrightunsigned(null, 1), arrow_typeof(shiftrightunsigned(null, 1));
----
NULL Int32

query IT
SELECT shiftrightunsigned(null, null), arrow_typeof(shiftrightunsigned(null, null));
----
NULL Int32

query IT
SELECT shiftrightunsigned(CAST(1 AS bigint), null), arrow_typeof(shiftrightunsigned(CAST(1 AS bigint), null));
----
NULL Int64
