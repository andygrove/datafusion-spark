## Original Query: SELECT shiftright(4, 1);
## PySpark 3.5.5 Result: {'shiftright(4, 1)': 2, 'typeof(shiftright(4, 1))': 'int', 'typeof(4)': 'int', 'typeof(1)': 'int'}

# Basic shiftright tests
query I
SELECT shiftright(CAST(4 AS int), CAST(1 AS int));
----
2

query I
SELECT shiftright(CAST(8 AS int), CAST(2 AS int));
----
2

query I
SELECT shiftright(CAST(16 AS int), CAST(3 AS int));
----
2

# Different data types
query I
SELECT shiftright(CAST(4 AS bigint), CAST(1 AS int));
----
2

query I
SELECT shiftright(CAST(8 AS bigint), CAST(2 AS int));
----
2

query I
SELECT shiftright(CAST(4 AS int), CAST(1 AS bigint));
----
2

# Large shifts (should handle modulo correctly)
query I
SELECT shiftright(CAST(1 AS int), CAST(32 AS int));
----
1

query I
SELECT shiftright(CAST(2 AS int), CAST(33 AS int));
----
1

query I
SELECT shiftright(CAST(3 AS int), CAST(64 AS int));
----
3

# Negative shifts
query I
SELECT shiftright(CAST(4 AS int), -CAST(1 AS int));
----
0

query I
SELECT shiftright(CAST(8 AS int), -CAST(2 AS int));
----
0

query I
SELECT shiftright(CAST(16 AS int), -CAST(3 AS int));
----
0

# Zero shifts
query I
SELECT shiftright(CAST(5 AS int), CAST(0 AS int));
----
5

query I
SELECT shiftright(CAST(0 AS int), CAST(5 AS int));
----
0

# Edge cases - signed right shift preserves sign
query I
SELECT shiftright(-CAST(4 AS int), CAST(1 AS int));
----
-2

query I
SELECT shiftright(-CAST(8 AS int), CAST(2 AS int));
----
-2

query I
SELECT shiftright(-CAST(16 AS int), CAST(3 AS int));
----
-2

query I
SELECT shiftright(CAST(2147483647 AS int), CAST(1 AS int));
----
1073741823

# Null handling
query I
SELECT shiftright(CAST(NULL AS int), CAST(1 AS int));
----
NULL

query I
SELECT shiftright(CAST(1 AS int), CAST(NULL AS int));
----
NULL

query I
SELECT shiftright(CAST(NULL AS int), CAST(NULL AS int));
----
NULL

query I
select shiftright(CAST(3 AS int),-31);
----
1

query I
select shiftright(CAST(3 AS int),-32);
----
3

# i32 + nulls
query IT
SELECT
	shiftright(CAST(value AS INT), shift),
	arrow_typeof(shiftright(CAST(value AS INT), shift))
FROM VALUES
(4, 1),
(8, 2),
(16, 3),
(32, 4),
(null, 2),
(8, null)
t(value, shift)
----
2 Int32
2 Int32
2 Int32
2 Int32
NULL Int32
NULL Int32

# big shifts
query IT
SELECT
	shiftright(CAST(value AS INT), shift),
	arrow_typeof(shiftright(CAST(value AS INT), shift))
FROM VALUES
(1, 32),
(2, 33),
(3, 64)
t(value, shift)
----
1 Int32
1 Int32
3 Int32

# negative shift
query IT
SELECT
	shiftright(CAST(value AS INT), shift),
	arrow_typeof(shiftright(CAST(value AS INT), shift))
FROM VALUES
(4, -1),
(8, -2),
(16, -3)
t(value, shift)
----
0 Int32
0 Int32
0 Int32

# For signed integers, right shift preserves sign bit
query IT
SELECT
	shiftright(CAST(value AS INT), shift),
	arrow_typeof(shiftright(CAST(value AS INT), shift))
FROM VALUES
(-4, 1),
(-8, 2),
(-16, 3)
t(value, shift)
----
-2 Int32
-2 Int32
-2 Int32

# i64 value
query IT
SELECT
	shiftright(CAST(value AS BIGINT), shift),
	arrow_typeof(shiftright(CAST(value AS BIGINT), shift))
FROM VALUES (4, 1), (8, 2), (16, 3) t(value, shift)
----
2 Int64
2 Int64
2 Int64

# u32 value
query IT
SELECT
	shiftright(arrow_cast(value, 'UInt32'), shift),
	arrow_typeof(shiftright(arrow_cast(value, 'UInt32'), shift))
FROM VALUES (4, 1), (8, 2), (16, 3) t(value, shift)
----
2 UInt32
2 UInt32
2 UInt32

# u64 value
query IT
SELECT
	shiftright(arrow_cast(value, 'UInt64'), shift),
	arrow_typeof(shiftright(arrow_cast(value, 'UInt64'), shift))
FROM VALUES (4, 1), (8, 2), (16, 3) t(value, shift)
----
2 UInt64
2 UInt64
2 UInt64

# pure null handling
query IT
SELECT shiftright(null, 1), arrow_typeof(shiftright(null, 1));
----
NULL Int32

query IT
SELECT shiftright(null, null), arrow_typeof(shiftright(null, null));
----
NULL Int32

query IT
SELECT shiftright(CAST(1 AS bigint), null), arrow_typeof(shiftright(CAST(1 AS bigint), null));
----
NULL Int64
