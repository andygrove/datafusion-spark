query D
SELECT next_day(CAST('2015-01-14' AS DATE), CAST('TU' AS string));
----
2015-01-20

query D
SELECT next_day(CAST('2015-07-27' AS DATE), CAST('Sun' AS string));
----
2015-08-02

query D
SELECT next_day(CAST('2015-07-27' AS DATE), CAST('Sat' AS string));
----
2015-08-01

# Whitespace-padded day names should be rejected (return NULL) per Spark behavior
query D
SELECT next_day(CAST('2015-01-14' AS DATE), CAST(' MO ' AS string));
----
NULL

query error Function 'next_day' expects 2 arguments but received 1
SELECT next_day(CAST('2015-07-27' AS DATE));

query error Function 'next_day' expects 2 arguments but received 1
SELECT next_day(CAST('Sun' AS string));

query error 'next_day' does not support zero arguments
SELECT next_day();

query error Function 'next_day' requires Date, but received Int32
SELECT next_day(CAST(1 AS int), CAST('Sun' AS string));

query error Function 'next_day' expects 2 arguments but received 3
SELECT next_day(CAST('2015-07-27' AS DATE), CAST('Sat' AS string), CAST('Sun' AS string));

# xfail spark: next_day casts a string to DATE with Arrow's cast, Spark's cast gives NULL (https://github.com/apache/datafusion-spark/issues/353)
query error Cannot cast string 'invalid_date' to value of Date32 type
SELECT next_day(CAST('invalid_date' AS string), CAST('Mon' AS string));

query D
SELECT next_day(CAST('2000-01-01' AS DATE), CAST(2.0 AS float));
----
NULL

# Preserve implicit weekday-to-string conversions.
query D
SELECT next_day(DATE '2015-07-23', CAST('Mon' AS BINARY));
----
2015-07-27

query D
SELECT next_day(DATE '2015-07-23', true);
----
NULL

query D
SELECT next_day(CAST('2020-01-01' AS DATE), CAST('invalid_day' AS string));
----
NULL

# xfail spark: test: DataFusion's CAST to DATE errors on an invalid date, Spark's non-ANSI CAST returns NULL
query error Cast error: Cannot cast string '2015-13-32' to value of Date32 type
SELECT next_day(CAST('2015-13-32' AS DATE), CAST('Sun' AS string));

query D
SELECT next_day(a, b)
FROM VALUES
    (CAST('2000-01-01' AS DATE), CAST('Mon' AS string)),
    (CAST(NULL AS DATE), CAST(NULL AS string)),
    (CAST(NULL AS DATE), CAST('Mon' AS string)),
    (CAST('2015-01-14' AS DATE), CAST(NULL AS string)) as t(a, b);
----
2000-01-03
NULL
NULL
NULL

# https://github.com/apache/datafusion/issues/23891
# Far-future start dates whose next occurrence lands past chrono::NaiveDate::MAX
# (epoch day 95026236) must still return a value, matching Spark's integer
# arithmetic, rather than panicking. Cast the Date32 result to Int32 to assert
# the epoch day directly (these dates are past the printable range).
query I
SELECT arrow_cast(next_day(date_from_unix_date(95026236), CAST('Mon' AS string)), 'Int32');
----
95026243

query I
SELECT arrow_cast(next_day(date_from_unix_date(95026230), CAST('Tue' AS string)), 'Int32');
----
95026237

# https://github.com/apache/datafusion/issues/23889
# Spark casts the start date to DATE, so STRING and TIMESTAMP are accepted
query D
SELECT next_day(CAST('2015-07-23' AS string), CAST('Mon' AS string));
----
2015-07-27

query D
SELECT next_day(CAST('2015-07-23 12:12:12' AS string), CAST('Mon' AS string));
----
2015-07-27

query D
SELECT next_day(CAST('2015-07-23 12:12:12' AS timestamp), CAST('Mon' AS string));
----
2015-07-27

# Timestamp-to-date conversion must round down before the Unix epoch.
query D
SELECT next_day(TIMESTAMP '1969-12-31 23:59:59', 'Thu');
----
1970-01-01

query D
SELECT next_day(a, CAST('Mon' AS string))
FROM VALUES
    (CAST('2015-07-23' AS string)),
    (CAST(NULL AS string)) as t(a);
----
2015-07-27
NULL

# Timestamp column with a day-of-week column
query D
SELECT next_day(a, b)
FROM VALUES
    (CAST('2015-07-23 12:12:12' AS timestamp), CAST('Mon' AS string)),
    (CAST('2015-07-23 23:59:59' AS timestamp), CAST('Fri' AS string)),
    (CAST(NULL AS timestamp), CAST('Mon' AS string)) as t(a, b);
----
2015-07-27
2015-07-24
NULL

# LargeUtf8 / Utf8View start dates
query D
SELECT next_day(arrow_cast('2015-07-23', 'LargeUtf8'), 'Mon');
----
2015-07-27

query D
SELECT next_day(CAST('2015-07-23' AS STRING), 'Mon');
----
2015-07-27

# String start date and LargeUtf8 / Utf8View day-of-week
query D
SELECT next_day('2015-07-23', arrow_cast('Mon', 'LargeUtf8'));
----
2015-07-27

query D
SELECT next_day('2015-07-23', CAST('Mon' AS STRING));
----
2015-07-27

# With ANSI mode on, Spark raises ILLEGAL_DAY_OF_WEEK for an unrecognized day name.
# https://github.com/apache/datafusion-spark/issues/113
statement ok
set datafusion.execution.enable_ansi_mode = true;

query error \[ILLEGAL_DAY_OF_WEEK\] Illegal input for day of week: xx\. SQLSTATE: 22009
SELECT next_day(DATE '2024-01-01', 'xx');

query error \[ILLEGAL_DAY_OF_WEEK\] Illegal input for day of week:\s+MO\s+\. SQLSTATE: 22009
SELECT next_day(DATE '2015-01-14', ' MO ');

query error \[ILLEGAL_DAY_OF_WEEK\] Illegal input for day of week:\s+MO\. SQLSTATE: 22009
SELECT next_day(DATE '2015-01-14', ' MO');

query error \[ILLEGAL_DAY_OF_WEEK\] Illegal input for day of week: MO\s+\. SQLSTATE: 22009
SELECT next_day(DATE '2015-01-14', 'MO ');

# Empty weekday string under ANSI mode
query error \[ILLEGAL_DAY_OF_WEEK\] Illegal input for day of week:\s*\. SQLSTATE: 22009
SELECT next_day(DATE '2024-01-01', '');

# 4-character invalid abbreviation under ANSI mode
query error \[ILLEGAL_DAY_OF_WEEK\] Illegal input for day of week: TUES\. SQLSTATE: 22009
SELECT next_day(DATE '2024-01-01', 'TUES');

# NULL inputs short-circuit in ANSI mode
query D
SELECT next_day(CAST(NULL AS DATE), 'xx');
----
NULL

query D
SELECT next_day(DATE '2024-01-01', NULL);
----
NULL

# Valid day names succeed in ANSI mode (including lowercase and mixed case)
query D
SELECT next_day(DATE '2024-01-01', 'TU');
----
2024-01-02

query D
SELECT next_day(DATE '2024-01-01', 'Tuesday');
----
2024-01-02

query D
SELECT next_day(DATE '2024-01-01', 'tu');
----
2024-01-02

query D
SELECT next_day(DATE '2024-01-01', 'mOnDaY');
----
2024-01-08

# LargeUtf8 and Utf8View with invalid day under ANSI mode
query error \[ILLEGAL_DAY_OF_WEEK\] Illegal input for day of week: invalid_day\. SQLSTATE: 22009
SELECT next_day('2024-01-01', arrow_cast('invalid_day', 'LargeUtf8'));

query error \[ILLEGAL_DAY_OF_WEEK\] Illegal input for day of week: invalid_day\. SQLSTATE: 22009
SELECT next_day('2024-01-01', CAST('invalid_day' AS STRING));

# Unicode day names folding via Unicode case folding (Spark DateTimeUtils.toUpperCase(Locale.ROOT))
query D
SELECT next_day(DATE '2024-01-01', 'ſu');
----
2024-01-07

query D
SELECT next_day(DATE '2024-01-01', 'frı');
----
2024-01-05

# Column inputs with ANSI mode enabled (maintainer test gap)
query D
SELECT next_day(a, b) FROM VALUES (CAST(NULL AS DATE), 'xx'), (DATE '2024-01-01', 'TU') AS t(a, b);
----
NULL
2024-01-02

query error \[ILLEGAL_DAY_OF_WEEK\] Illegal input for day of week: xx\. SQLSTATE: 22009
SELECT next_day(a, b) FROM VALUES (DATE '2024-01-01', 'xx'), (DATE '2024-01-01', 'TU') AS t(a, b);

statement ok
set datafusion.execution.enable_ansi_mode = false;

# With ANSI mode off, invalid day of week returns NULL (legacy / non-ANSI behavior)
query D
SELECT next_day(DATE '2024-01-01', 'xx');
----
NULL

query D
SELECT next_day(DATE '2015-01-14', ' MO ');
----
NULL

query D
SELECT next_day(DATE '2015-01-14', ' MO');
----
NULL

query D
SELECT next_day(DATE '2015-01-14', 'MO ');
----
NULL

query D
SELECT next_day(DATE '2024-01-01', '');
----
NULL

query D
SELECT next_day(DATE '2024-01-01', 'TUES');
----
NULL

query D
SELECT next_day(DATE '2024-01-01', 'tu');
----
2024-01-02

query D
SELECT next_day(DATE '2024-01-01', 'mOnDaY');
----
2024-01-08

# Unicode day names with ANSI mode off
query D
SELECT next_day(DATE '2024-01-01', 'ſu');
----
2024-01-07

query D
SELECT next_day(DATE '2024-01-01', 'frı');
----
2024-01-05
