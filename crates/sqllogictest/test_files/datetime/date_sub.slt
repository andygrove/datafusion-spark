## Original Query: SELECT date_sub('2016-07-30', 1);
## PySpark 3.5.5 Result: {'date_sub(2016-07-30, 1)': datetime.date(2016, 7, 29), 'typeof(date_sub(2016-07-30, 1))': 'date', 'typeof(2016-07-30)': 'string', 'typeof(1)': 'int'}

# Basic date_sub tests
query D
SELECT date_sub(CAST('2016-07-30' AS date), CAST(1 AS int));
----
2016-07-29

query D
SELECT date_sub(CAST('2016-07-30' AS date), CAST(1 AS TINYINT));
----
2016-07-29

query D
SELECT date_sub(CAST('2016-07-30' AS date), CAST(1 AS SMALLINT));
----
2016-07-29

query D
SELECT date_sub(CAST('2016-07-30' AS date), CAST(0 AS int));
----
2016-07-30

# xfail spark: test: CAST of a DATE to INT is NULL in Spark, the test should use unix_date to get the day count
query I
SELECT CAST(date_sub(CAST('1969-01-01' AS date), CAST(2147483647 AS int)) AS int);
----
2147483284

query D
SELECT date_sub(CAST('2016-07-30' AS date), CAST(100000 AS int));
----
1742-10-15

# Test with negative day values (should add days)
query D
SELECT date_sub(CAST('2016-07-30' AS date), -CAST(1 AS int));
----
2016-07-31

query D
SELECT date_sub(CAST('2016-07-30' AS date), -CAST(5 AS int));
----
2016-08-04

# Test with NULL values
query D
SELECT date_sub(CAST(NULL AS date), CAST(1 AS int));
----
NULL

query D
SELECT date_sub(CAST('2016-07-30' AS date), CAST(NULL AS int));
----
NULL

query D
SELECT date_sub(CAST(NULL AS date), CAST(NULL AS int));
----
NULL

# Spark implicitly casts a string to DATE (https://github.com/apache/datafusion-spark/issues/41)
# xfail spark: Spark implicitly casts a string argument to DATE/TIMESTAMP, invalid strings give NULL (https://github.com/apache/datafusion-spark/issues/41)
statement error Failed to coerce arguments to satisfy a call to 'date_sub' function
SELECT date_sub('2024-01-01', CAST(1 AS INT));

# An integer literal is BIGINT here and INT in Spark, where this works (https://github.com/apache/datafusion-spark/issues/97)
# xfail spark: An integer literal is BIGINT here and INT in Spark (https://github.com/apache/datafusion-spark/issues/97)
statement error Failed to coerce arguments to satisfy a call to 'date_sub' function
SELECT date_sub(DATE '2024-01-01', 1);
