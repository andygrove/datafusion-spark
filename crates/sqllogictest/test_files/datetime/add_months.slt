# `add_months` has no `invoke_with_args` yet, so the records that call it are marked
# `skipif evaluate` until https://github.com/apache/datafusion-spark/issues/312 is fixed.

skipif evaluate
query D
SELECT add_months(CAST('2016-07-30' AS date), CAST(1 AS int));
----
2016-08-30

skipif evaluate
query D
SELECT add_months(CAST('2016-07-30' AS date), CAST(0 AS int));
----
2016-07-30

skipif evaluate
query D
SELECT add_months(CAST('2016-07-30' AS date), CAST(10000 AS int));
----
2849-11-30

# Test integer overflow
skipif evaluate
query error
SELECT add_months(CAST('2016-07-30' AS date), CAST(2147483647 AS int));
----
DataFusion error: Arrow error: Compute error: Date arithmetic overflow: 17012 + 2147483647 months


skipif evaluate
query D
SELECT add_months(CAST('2016-07-30' AS date), -CAST(5 AS int));
----
2016-02-29

# Test with NULL values
skipif evaluate
query D
SELECT add_months(CAST(NULL AS date), CAST(1 AS int));
----
NULL

skipif evaluate
query D
SELECT add_months(CAST('2016-07-30' AS date), CAST(NULL AS int));
----
NULL

skipif evaluate
query D
SELECT add_months(CAST(NULL AS date), CAST(NULL AS int));
----
NULL

# Spark implicitly casts a string to DATE and returns 2024-02-29 (https://github.com/apache/datafusion-spark/issues/41)
# xfail spark: Spark implicitly casts a string argument to DATE/TIMESTAMP, invalid strings give NULL (https://github.com/apache/datafusion-spark/issues/41)
statement error Failed to coerce arguments to satisfy a call to 'add_months' function
SELECT add_months('2024-01-31', CAST(1 AS INT));

# An integer literal is BIGINT here and INT in Spark, where this returns 2024-02-29 (https://github.com/apache/datafusion-spark/issues/97)
# xfail spark: An integer literal is BIGINT here and INT in Spark (https://github.com/apache/datafusion-spark/issues/97)
statement error Failed to coerce arguments to satisfy a call to 'add_months' function
SELECT add_months(DATE '2024-01-31', 1);
