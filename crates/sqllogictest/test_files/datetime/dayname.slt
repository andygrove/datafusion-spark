# Tests for Spark-compatible dayname (Spark 4.0+)
# Reference: https://spark.apache.org/docs/latest/api/sql/index.html#dayname
# The first value is the example from the Spark docs; the rest follow from the
# calendar (2024-01-01 is a Monday).

query T
SELECT dayname(CAST('2008-02-20' AS DATE));
----
Wed

# All seven days
query T
SELECT dayname(CAST('2024-01-01' AS DATE));
----
Mon

query T
SELECT dayname(CAST('2024-01-02' AS DATE));
----
Tue

query T
SELECT dayname(CAST('2024-01-03' AS DATE));
----
Wed

query T
SELECT dayname(CAST('2024-01-04' AS DATE));
----
Thu

query T
SELECT dayname(CAST('2024-01-05' AS DATE));
----
Fri

query T
SELECT dayname(CAST('2024-01-06' AS DATE));
----
Sat

query T
SELECT dayname(CAST('2024-01-07' AS DATE));
----
Sun

# Epoch and dates before it
query T
SELECT dayname(CAST('1970-01-01' AS DATE));
----
Thu

query T
SELECT dayname(CAST('1969-12-31' AS DATE));
----
Wed

# Leap day
query T
SELECT dayname(CAST('2024-02-29' AS DATE));
----
Thu

# NULL
query T
SELECT dayname(CAST(NULL AS DATE));
----
NULL

# Calendar boundaries. 1582-10-04 is the last Julian day before the Gregorian
# switch. Spark uses the proleptic Gregorian calendar, so it is a Monday.
query TTT
SELECT dayname(CAST('0001-01-01' AS DATE)), dayname(CAST('9999-12-31' AS DATE)), dayname(CAST('1582-10-04' AS DATE));
----
Mon Fri Mon

# Dates from Comet's unit tests
query TTT
SELECT dayname(CAST('2024-01-15' AS DATE)), dayname(CAST('2024-06-30' AS DATE)), dayname(CAST('2020-12-31' AS DATE));
----
Mon Sun Thu

# Untyped NULL gives a NULL string
query TT
SELECT dayname(NULL), arrow_typeof(dayname(NULL));
----
NULL Utf8

# Strings are implicitly cast to dates
query T
SELECT dayname(CAST('2008-02-20' AS STRING));
----
Wed

query T
SELECT dayname(CAST('2024-05-20 23:30:00' AS STRING));
----
Mon

query T
SELECT dayname(d) FROM (VALUES (CAST('2024-01-01' AS STRING)), (CAST(NULL AS STRING)), (CAST('2024-01-07' AS STRING))) AS t(d);
----
Mon
NULL
Sun

# Spark returns NULL for a malformed string when ANSI mode is off. DataFusion's
# string to date cast errors regardless of ANSI mode. ANSI-aware casting is
# tracked by https://github.com/apache/datafusion-spark/issues/88
# query T
# SELECT dayname('abc'::STRING);
# ----
# NULL

# With ANSI mode on, Spark raises CAST_INVALID_INPUT for a malformed string
statement ok
set datafusion.execution.enable_ansi_mode = true;

query error Cannot cast string 'abc' to value of Date32 type
SELECT dayname(CAST('abc' AS STRING));

statement ok
set datafusion.execution.enable_ansi_mode = false;

# Timestamps are cast to dates
query T
SELECT dayname(arrow_cast('2024-05-20 23:59:59', 'Timestamp(Microsecond, None)'));
----
Mon

# A timestamp with a time zone is cast to a date in its own time zone. With
# the default UTC session time zone this matches Spark.
query T
SELECT dayname(arrow_cast('2024-05-21T02:00:00Z', 'Timestamp(Microsecond, Some("UTC"))'));
----
Tue

# Spark casts a timestamp to a date in the session time zone, so in
# America/New_York the instant 2024-05-21T02:00:00Z is a Monday. DataFusion
# uses the timestamp's own time zone (UTC) and returns Tue. Session time zone
# aware timestamp to date casting is tracked by
# https://github.com/apache/datafusion-spark/issues/88
statement ok
set datafusion.execution.time_zone = 'America/New_York';

# query T
# SELECT dayname(arrow_cast('2024-05-21T02:00:00Z', 'Timestamp(Microsecond, Some("UTC"))'));
# ----
# Mon

statement ok
reset datafusion.execution.time_zone;

# Result type
query T
SELECT arrow_typeof(dayname(CAST('2024-01-01' AS DATE)));
----
Utf8

# Column input, including NULL
query T
SELECT dayname(d) FROM (VALUES (CAST('2024-01-01' AS DATE)), (CAST(NULL AS DATE)), (CAST('2024-01-07' AS DATE))) AS t(d);
----
Mon
NULL
Sun

# Spark raises DATATYPE_MISMATCH.UNEXPECTED_INPUT_TYPE for an integer
statement error Function 'dayname' requires Date, but received Int32
SELECT dayname(CAST(1 AS INT));

statement error 'dayname' does not support zero arguments
SELECT dayname();
