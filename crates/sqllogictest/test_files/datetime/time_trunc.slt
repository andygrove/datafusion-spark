# HOUR - zero out minute and second with fraction
query D
SELECT time_trunc('HOUR', CAST('09:32:05.123456' AS time));
----
09:00:00

# MINUTE - zero out second with fraction
query D
SELECT time_trunc('MINUTE', CAST('09:32:05.123456' AS time));
----
09:32:00

query D
SELECT time_trunc('minute', CAST('09:32:05.123456' AS time));
----
09:32:00

query error `unit` in `time_trunc` is invalid: expects one of the units 'HOUR', 'MINUTE', 'SECOND', 'MILLISECOND', 'MICROSECOND', but got 'MINS'. SQLSTATE: 22023
SELECT time_trunc('MINS', CAST('09:32:05.123456' AS time));

# SECOND - zero out fraction
query D
SELECT time_trunc('SECOND', CAST('09:32:05.123456' AS time));
----
09:32:05

# MILLISECOND - zero out microseconds
query D
SELECT time_trunc('MILLISECOND', CAST('09:32:05.123456' AS time));
----
09:32:05.123

# MICROSECOND - everything remains
query D
SELECT time_trunc('MICROSECOND', CAST('09:32:05.123456' AS time));
----
09:32:05.123456

query D
SELECT time_trunc('HOUR', column1)
FROM VALUES
(CAST('09:32:05.123456' AS time)),
(CAST('22:45:30.654321' AS time)),
(CAST('14:20:10.000001' AS time)),
(CAST(NULL AS time));
----
09:00:00
22:00:00
14:00:00
NULL


# Null handling
query D
SELECT time_trunc(NULL, CAST('09:32:05.123456' AS time));
----
NULL

query D
SELECT time_trunc('HOUR', CAST(NULL AS time));
----
NULL

# incorrect format
query error `unit` in `time_trunc` is invalid: expects one of the units 'HOUR', 'MINUTE', 'SECOND', 'MILLISECOND', 'MICROSECOND', but got 'test'. SQLSTATE: 22023
SELECT time_trunc('test', CAST('09:32:05.123456' AS time));
