# `trunc` has no `invoke_with_args` yet, so the records that call it are marked
# `skipif evaluate` until https://github.com/apache/datafusion-spark/issues/311 is fixed.

# YEAR - truncate to first date of year
skipif evaluate
query D
SELECT trunc(CAST('2009-02-12' AS date), CAST('YEAR' AS string));
----
2009-01-01

skipif evaluate
query D
SELECT trunc(CAST('2009-02-12' AS date), CAST('YYYY' AS string));
----
2009-01-01

skipif evaluate
query D
SELECT trunc(CAST('2009-02-12' AS date), CAST('YY' AS string));
----
2009-01-01

# QUARTER - truncate to first date of quarter
skipif evaluate
query D
SELECT trunc(CAST('2009-02-12' AS date), CAST('QUARTER' AS string));
----
2009-01-01

# MONTH - truncate to first date of month
skipif evaluate
query D
SELECT trunc(CAST('2009-02-12' AS date), CAST('MONTH' AS string));
----
2009-02-01

skipif evaluate
query D
SELECT trunc(CAST('2009-02-12' AS date), CAST('MM' AS string));
----
2009-02-01

skipif evaluate
query D
SELECT trunc(CAST('2009-02-12' AS date), CAST('MON' AS string));
----
2009-02-01

# xfail spark: Spark returns NULL for an unsupported or NULL trunc/date_trunc format (https://github.com/apache/datafusion-spark/issues/40)
skipif evaluate
query D
SELECT trunc(CAST('2009-02-12' AS date), CAST('MONTHS' AS string));
----
2009-02-01

# WEEK - truncate to Monday of the week
skipif evaluate
query D
SELECT trunc(CAST('2009-02-12' AS date), CAST('WEEK' AS string));
----
2009-02-09

# string input
skipif evaluate
query D
SELECT trunc(CAST('2009-02-12' AS string), CAST('YEAR' AS string));
----
2009-01-01

skipif evaluate
query D
SELECT trunc(column1, CAST('YEAR' AS string))
FROM VALUES
(CAST('2009-02-12' AS date)),
(CAST('2000-02-12' AS date)),
(CAST('2042-02-12' AS date)),
(CAST(NULL AS date));
----
2009-01-01
2000-01-01
2042-01-01
NULL

# Null handling
skipif evaluate
query D
SELECT trunc(CAST(NULL AS date), CAST('YEAR' AS string));
----
NULL

# xfail spark: Spark returns NULL for an unsupported or NULL trunc/date_trunc format (https://github.com/apache/datafusion-spark/issues/40)
skipif evaluate
query error DataFusion error: Optimizer rule 'simplify_expressions' failed\ncaused by\nError during planning: Second argument of `TRUNC` must be non-null scalar Utf8
SELECT trunc(CAST('2009-02-12' AS date), CAST(NULL AS string));

# incorrect format
# xfail spark: Spark returns NULL for an unsupported or NULL trunc/date_trunc format (https://github.com/apache/datafusion-spark/issues/40)
skipif evaluate
query error DataFusion error: Optimizer rule 'simplify_expressions' failed\ncaused by\nError during planning: The format argument of `TRUNC` must represent a year, month, day, week, or quarter.
SELECT trunc(CAST('2009-02-12' AS date), CAST('test' AS string));
