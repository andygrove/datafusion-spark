# `date_part` has no `invoke_with_args` yet, so the records that call it are marked
# `skipif evaluate` until https://github.com/apache/datafusion-spark/issues/308 is fixed.

# YEAR
skipif evaluate
query I
SELECT date_part('YEAR'::string, '2000-01-01'::date);
----
2000

skipif evaluate
query I
SELECT date_part('YEARS'::string, '2000-01-01'::date);
----
2000

skipif evaluate
query I
SELECT date_part('Y'::string, '2000-01-01'::date);
----
2000

skipif evaluate
query I
SELECT date_part('YR'::string, '2000-01-01'::date);
----
2000

skipif evaluate
query I
SELECT date_part('YRS'::string, '2000-01-01'::date);
----
2000

# YEAROFWEEK
skipif evaluate
query I
SELECT date_part('YEAROFWEEK'::string, '2000-01-01'::date);
