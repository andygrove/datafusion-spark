# SECOND
# xfail spark: date_part('SECOND', ts) returns INT, Spark returns DECIMAL(8,6) with the fraction (https://github.com/apache/datafusion-spark/issues/38)
query I
SELECT date_part(CAST('SECOND' AS string), CAST('2000-01-01 12:30:45' AS timestamp));
----
45

# xfail spark: date_part('SECOND', ts) returns INT, Spark returns DECIMAL(8,6) with the fraction (https://github.com/apache/datafusion-spark/issues/38)
query I
SELECT date_part(CAST('S' AS string), CAST('2000-01-01 12:30:45' AS timestamp));
----
45

# xfail spark: date_part('SECOND', ts) returns INT, Spark returns DECIMAL(8,6) with the fraction (https://github.com/apache/datafusion-spark/issues/38)
query I
SELECT date_part(CAST('SEC' AS string), CAST('2000-01-01 12:30:45' AS timestamp));
----
45

# xfail spark: date_part('SECOND', ts) returns INT, Spark returns DECIMAL(8,6) with the fraction (https://github.com/apache/datafusion-spark/issues/38)
query I
SELECT date_part(CAST('SECONDS' AS string), CAST('2000-01-01 12:30:45' AS timestamp));
----
45

# xfail spark: date_part('SECOND', ts) returns INT, Spark returns DECIMAL(8,6) with the fraction (https://github.com/apache/datafusion-spark/issues/38)
query I
SELECT date_part(CAST('SECS' AS string), CAST('2000-01-01 12:30:45' AS timestamp));
----
45

# Known difference: Spark returns DECIMAL(8, 6) including the fraction (45.999000)
# xfail spark: date_part('SECOND', ts) returns INT, Spark returns DECIMAL(8,6) with the fraction (https://github.com/apache/datafusion-spark/issues/38)
query I
SELECT date_part(CAST('SECOND' AS string), CAST('2000-01-01 12:30:45.999' AS timestamp));
----
45

# NULL input
query I
SELECT date_part(CAST('year' AS string), CAST(NULL AS timestamp));
----
NULL

# xfail spark: date_part with a NULL field returns a NULL INT, Spark returns a NULL DOUBLE (https://github.com/apache/datafusion-spark/issues/363)
query I
SELECT date_part(CAST(NULL AS string), CAST('2000-01-01' AS date));
----
NULL

# Invalid part
# The error comes from planning in simplify mode and from execution in evaluate mode,
# so the message differs.
skipif evaluate
query error
SELECT date_part(CAST('test' AS string), CAST('2000-01-01' AS date));
----
DataFusion error: Optimizer rule 'simplify_expressions' failed
caused by
Error during planning: Cannot extract `test` from Date32. SQLSTATE: 42601


query I
SELECT date_part('year', column1)
FROM VALUES
(CAST('2022-03-15' AS date)),
(CAST('1999-12-31' AS date)),
(CAST('2000-01-01' AS date)),
(CAST(NULL AS date));
----
2022
1999
2000
NULL

query I
SELECT date_part('minutes', column1)
FROM VALUES
(CAST('2022-03-15 12:30:45' AS timestamp)),
(CAST('1999-12-31 12:32:45' AS timestamp)),
(CAST('2000-01-01 12:00:45' AS timestamp)),
(CAST(NULL AS timestamp));
----
30
32
0
NULL

# alias datepart
query I
SELECT datepart(CAST('YEAR' AS string), CAST('2000-01-01' AS date));
----
2000

query I
SELECT datepart('year', column1)
FROM VALUES
(CAST('2022-03-15' AS date)),
(CAST('1999-12-31' AS date)),
(CAST('2000-01-01' AS date)),
(CAST(NULL AS date));
----
2022
1999
2000
NULL

# Nullable even for a non-null input, like the integer parts of the date_part
# this simplifies to
query TTT
DESCRIBE SELECT date_part(CAST('SECOND' AS string), ts) AS s FROM (VALUES (timestamp '2020-01-01')) AS t(ts)
----
s Int32 YES

# A field from a column is rejected when the query is planned, like Spark. Evaluate
# mode rejects it at execution instead, so the message differs.
skipif evaluate
query error
SELECT date_part(column1, column2) FROM VALUES ('year', CAST('2000-01-01' AS date));
----
DataFusion error: Optimizer rule 'simplify_expressions' failed
caused by
Error during planning: First argument of `DATE_PART` must be a constant string


# Also for an empty input. Evaluate mode runs nothing, so it does not fail.
skipif evaluate
query error
SELECT date_part(column1, column2) FROM VALUES ('year', CAST('2000-01-01' AS date)) WHERE false;
----
DataFusion error: Optimizer rule 'simplify_expressions' failed
caused by
Error during planning: First argument of `DATE_PART` must be a constant string


# A field that is only known at execution time, such as a prepared statement parameter
statement ok
PREPARE extract_field(VARCHAR) AS SELECT date_part($1, CAST('2000-01-01' AS date));

query I
EXECUTE extract_field('YEAR');
----
2000

statement ok
DEALLOCATE extract_field;
