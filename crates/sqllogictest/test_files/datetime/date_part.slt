# YEAR
query I
SELECT date_part(CAST('YEAR' AS string), CAST('2000-01-01' AS date));
----
2000

query I
SELECT date_part(CAST('YEARS' AS string), CAST('2000-01-01' AS date));
----
2000

query I
SELECT date_part(CAST('Y' AS string), CAST('2000-01-01' AS date));
----
2000

query I
SELECT date_part(CAST('YR' AS string), CAST('2000-01-01' AS date));
----
2000

query I
SELECT date_part(CAST('YRS' AS string), CAST('2000-01-01' AS date));
----
2000

# YEAROFWEEK
query I
SELECT date_part(CAST('YEAROFWEEK' AS string), CAST('2000-01-01' AS date));
----
1999

# QUARTER
query I
SELECT date_part(CAST('QUARTER' AS string), CAST('2000-01-01' AS date));
----
1

query I
SELECT date_part(CAST('QTR' AS string), CAST('2000-01-01' AS date));
----
1

# The error comes from planning in simplify mode and from execution in evaluate mode,
# so the message differs.
skipif evaluate
query error
SELECT date_part(CAST('QUARTERS' AS string), CAST('2000-01-01' AS date));
----
DataFusion error: Optimizer rule 'simplify_expressions' failed
caused by
Error during planning: Cannot extract `QUARTERS` from Date32. SQLSTATE: 42601


