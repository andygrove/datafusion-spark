# Known difference: Spark returns DECIMAL(8, 6) including the fraction (45.999000)
skipif evaluate
query I
SELECT date_part('SECOND'::string, '2000-01-01 12:30:45.999'::timestamp);
----
45

# NULL input
skipif evaluate
query I
SELECT date_part('year'::string, NULL::timestamp);
----
NULL

skipif evaluate
query I
SELECT date_part(NULL::string, '2000-01-01'::date);
----
NULL

