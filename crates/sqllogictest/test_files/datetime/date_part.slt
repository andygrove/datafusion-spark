skipif evaluate
query I
SELECT date_part('year', column1)
FROM VALUES
('2022-03-15'::date),
('1999-12-31'::date),
('2000-01-01'::date),
(NULL::date);
----
2022
1999
2000
NULL

skipif evaluate
query I
SELECT date_part('minutes', column1)
FROM VALUES
('2022-03-15 12:30:45'::timestamp),
('1999-12-31 12:32:45'::timestamp),
('2000-01-01 12:00:45'::timestamp),
(NULL::timestamp);
----
30
32
0
NULL

# alias datepart
skipif evaluate
query I
SELECT datepart('YEAR'::string, '2000-01-01'::date);
----
2000

skipif evaluate
query I
SELECT datepart('year', column1)
FROM VALUES
('2022-03-15'::date),
('1999-12-31'::date),
('2000-01-01'::date),
(NULL::date);
----
2022
1999
2000
NULL

# Nullable even for a non-null input, like the integer parts of the date_part
# this simplifies to
query TTT
DESCRIBE SELECT date_part('SECOND'::string, ts) AS s FROM (VALUES (timestamp '2020-01-01')) AS t(ts)
----
s Int32 YES
