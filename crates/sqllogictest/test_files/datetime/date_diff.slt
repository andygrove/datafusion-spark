# `date_diff` has no `invoke_with_args` yet, so the records that call it are marked
# `skipif evaluate` until https://github.com/apache/datafusion-spark/issues/307 is fixed.

# date input
skipif evaluate
query I
SELECT date_diff(CAST('2009-07-30' AS date), CAST('2009-07-31' AS date));
----
-1

skipif evaluate
query I
SELECT date_diff(CAST('2009-07-31' AS date), CAST('2009-07-30' AS date));
----
1

skipif evaluate
query I
SELECT date_diff(CAST('2009-07-31' AS string), CAST('2009-07-30' AS date));
----
1

skipif evaluate
query I
SELECT date_diff(CAST('2009-07-31' AS timestamp), CAST('2009-07-30' AS date));
----
1

# Date64 input
skipif evaluate
query I
SELECT date_diff(arrow_cast('2009-07-31', 'Date64'), arrow_cast('2009-07-30', 'Date64'));
----
1

skipif evaluate
query I
SELECT date_diff(arrow_cast('2009-07-30', 'Date64'), arrow_cast('2009-07-31', 'Date64'));
----
-1

# Mixed Date32 and Date64 input
skipif evaluate
query I
SELECT date_diff(CAST('2009-07-31' AS date), arrow_cast('2009-07-30', 'Date64'));
----
1

skipif evaluate
query I
SELECT date_diff(arrow_cast('2009-07-31', 'Date64'), CAST('2009-07-30' AS date));
----
1


# Same date returns 0
skipif evaluate
query I
SELECT date_diff(CAST('2009-07-30' AS date), CAST('2009-07-30' AS date));
----
0

# Large difference
skipif evaluate
query I
SELECT date_diff(CAST('2020-01-01' AS date), CAST('1970-01-01' AS date));
----
18262

# timestamp input
skipif evaluate
query I
SELECT date_diff(CAST('2009-07-30 12:34:56' AS timestamp), CAST('2009-07-31 23:45:01' AS timestamp));
----
-1

skipif evaluate
query I
SELECT date_diff(CAST('2009-07-31 23:45:01' AS timestamp), CAST('2009-07-30 12:34:56' AS timestamp));
----
1

skipif evaluate
query I
SELECT date_diff(CAST('2009-07-31 23:45:01' AS string), CAST('2009-07-30 12:34:56' AS timestamp));
----
1

# string input
skipif evaluate
query I
SELECT date_diff('2009-07-30', '2009-07-31');
----
-1

skipif evaluate
query I
SELECT date_diff('2009-07-31', '2009-07-30');
----
1

# NULL handling
skipif evaluate
query I
SELECT date_diff(CAST(NULL AS date), CAST('2009-07-30' AS date));
----
NULL

skipif evaluate
query I
SELECT date_diff(CAST('2009-07-31' AS date), CAST(NULL AS date));
----
NULL

skipif evaluate
query I
SELECT date_diff(CAST(NULL AS date), CAST(NULL AS date));
----
NULL

skipif evaluate
query I
SELECT date_diff(column1, column2)
FROM VALUES
(CAST('2009-07-30' AS date), CAST('2009-07-31' AS date)),
(CAST('2009-07-31' AS date), CAST('2009-07-30' AS date)),
(CAST(NULL AS date), CAST('2009-07-30' AS date)),
(CAST('2009-07-31' AS date), CAST(NULL AS date)),
(CAST(NULL AS date), CAST(NULL AS date));
----
-1
1
NULL
NULL
NULL


# Alias datediff
skipif evaluate
query I
SELECT datediff(CAST('2009-07-30' AS date), CAST('2009-07-31' AS date));
----
-1

skipif evaluate
query I
SELECT datediff(column1, column2)
FROM VALUES
(CAST('2009-07-30' AS date), CAST('2009-07-31' AS date)),
(CAST('2009-07-31' AS date), CAST('2009-07-30' AS date)),
(CAST(NULL AS date), CAST('2009-07-30' AS date)),
(CAST('2009-07-31' AS date), CAST(NULL AS date)),
(CAST(NULL AS date), CAST(NULL AS date));
----
-1
1
NULL
NULL
NULL
