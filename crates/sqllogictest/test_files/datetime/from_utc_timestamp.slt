# String inputs
query P
SELECT from_utc_timestamp(CAST('2016-08-31' AS string), CAST('UTC' AS string));
----
2016-08-31T00:00:00

query P
SELECT from_utc_timestamp(CAST('2016-08-31' AS string), CAST('Asia/Seoul' AS string));
----
2016-08-31T09:00:00

query P
SELECT from_utc_timestamp(CAST('2016-08-31' AS string), CAST('America/New_York' AS string));
----
2016-08-30T20:00:00

# String inputs with offsets
query P
SELECT from_utc_timestamp(CAST('2018-03-13T06:18:23+02:00' AS string), CAST('UTC' AS string));
----
2018-03-13T04:18:23

query P
SELECT from_utc_timestamp(CAST('2018-03-13T06:18:23+02:00' AS string), CAST('Asia/Seoul' AS string));
----
2018-03-13T13:18:23

query P
SELECT from_utc_timestamp(CAST('2018-03-13T06:18:23+02:00' AS string), CAST('America/New_York' AS string));
----
2018-03-13T00:18:23

# Timestamp inputs
query P
SELECT from_utc_timestamp(CAST('2018-03-13T06:18:23+02:00' AS timestamp), CAST('UTC' AS string));
----
2018-03-13T04:18:23

query P
SELECT from_utc_timestamp(CAST('2018-03-13T06:18:23+02:00' AS timestamp), CAST('Asia/Seoul' AS string));
----
2018-03-13T13:18:23

query P
SELECT from_utc_timestamp(CAST('2018-03-13T06:18:23+02:00' AS timestamp), CAST('America/New_York' AS string));
----
2018-03-13T00:18:23

# Null inputs
query P
SELECT from_utc_timestamp(CAST(NULL AS string), CAST('Asia/Seoul' AS string));
----
NULL

query P
SELECT from_utc_timestamp(CAST(NULL AS timestamp), CAST('Asia/Seoul' AS string));
----
NULL

query P
SELECT from_utc_timestamp(CAST('2016-08-31' AS string), CAST(NULL AS string));
----
NULL

query P
SELECT from_utc_timestamp(column1, column2)
FROM VALUES
(CAST('2016-08-31' AS string), CAST('Asia/Seoul' AS string)),
(CAST('2018-03-13T06:18:23+02:00' AS string), CAST('Asia/Seoul' AS string)),
(CAST('2016-08-31' AS string), CAST('UTC' AS string)),
(CAST('2018-03-13T06:18:23+02:00' AS string), CAST('UTC' AS string)),
(CAST('2016-08-31' AS string), CAST('America/New_York' AS string)),
(CAST('2018-03-13T06:18:23+02:00' AS string), CAST('America/New_York' AS string)),
(CAST(NULL AS string), CAST('Asia/Seoul' AS string)),
(CAST('2016-08-31' AS string), CAST(NULL AS string));
----
2016-08-31T09:00:00
2018-03-13T13:18:23
2016-08-31T00:00:00
2018-03-13T04:18:23
2016-08-30T20:00:00
2018-03-13T00:18:23
NULL
NULL

query P
SELECT from_utc_timestamp(column1, column2)
FROM VALUES
(CAST('2016-08-31' AS timestamp), CAST('Asia/Seoul' AS string)),
(CAST('2018-03-13T06:18:23+02:00' AS timestamp), CAST('Asia/Seoul' AS string)),
(CAST('2016-08-31' AS timestamp), CAST('UTC' AS string)),
(CAST('2018-03-13T06:18:23+02:00' AS timestamp), CAST('UTC' AS string)),
(CAST('2016-08-31' AS timestamp), CAST('America/New_York' AS string)),
(CAST('2018-03-13T06:18:23+02:00' AS timestamp), CAST('America/New_York' AS string)),
(CAST(NULL AS timestamp), CAST('Asia/Seoul' AS string)),
(CAST('2018-03-13T06:18:23+00:00' AS timestamp), CAST(NULL AS string));
----
2016-08-31T09:00:00
2018-03-13T13:18:23
2016-08-31T00:00:00
2018-03-13T04:18:23
2016-08-30T20:00:00
2018-03-13T00:18:23
NULL
NULL

query P
SELECT from_utc_timestamp(arrow_cast(column1, 'Timestamp(Microsecond, Some("Asia/Seoul"))'), column2)
FROM VALUES
(CAST('2016-08-31' AS timestamp), CAST('Asia/Seoul' AS string)),
(CAST('2018-03-13T06:18:23+02:00' AS timestamp), CAST('Asia/Seoul' AS string)),
(CAST('2016-08-31' AS timestamp), CAST('UTC' AS string)),
(CAST('2018-03-13T06:18:23+02:00' AS timestamp), CAST('UTC' AS string)),
(CAST('2016-08-31' AS timestamp), CAST('America/New_York' AS string)),
(CAST('2018-03-13T06:18:23+02:00' AS timestamp), CAST('America/New_York' AS string)),
(CAST(NULL AS timestamp), CAST('Asia/Seoul' AS string)),
(CAST('2018-03-13T06:18:23+00:00' AS timestamp), CAST(NULL AS string));
----
2016-08-31T09:00:00+09:00
2018-03-13T13:18:23+09:00
2016-08-31T00:00:00+09:00
2018-03-13T04:18:23+09:00
2016-08-30T20:00:00+09:00
2018-03-13T00:18:23+09:00
NULL
NULL


# DST edge cases
query P
SELECT from_utc_timestamp(CAST('2020-03-31T13:40:00' AS timestamp), CAST('America/New_York' AS string));
----
2020-03-31T09:40:00


query P
SELECT from_utc_timestamp(CAST('2020-11-04T14:06:40' AS timestamp), CAST('America/New_York' AS string));
----
2020-11-04T09:06:40

# Spark timezone spellings supplied as column values, including second-resolution offsets.
query P
SELECT from_utc_timestamp(column1, column2)
FROM VALUES
(CAST('2024-07-01T00:00:00.123456' AS timestamp), CAST('PST' AS string)),
(CAST('2024-07-01T00:00:00.123456' AS timestamp), CAST('GMT+1' AS string)),
(CAST('2024-07-01T00:00:00.123456' AS timestamp), CAST('UTC+1:2' AS string)),
(CAST('2024-07-01T00:00:00.123456' AS timestamp), CAST('UT-010203' AS string)),
(CAST('2024-04-15T00:00:00.123456' AS timestamp), CAST('SystemV/PST8PDT' AS string)),
(CAST('2024-07-01T00:00:00.123456' AS timestamp), CAST('SystemV/HST10' AS string)),
(CAST(NULL AS timestamp), CAST('+19:00' AS string));
----
2024-06-30T17:00:00.123456
2024-07-01T01:00:00.123456
2024-07-01T01:02:00.123456
2024-06-30T22:57:57.123456
2024-04-14T16:00:00.123456
2024-06-30T14:00:00.123456
NULL

# Arrow accepts this offset, but Spark limits offsets to 18 hours.
query error invalid timezone '\+19:00'
SELECT from_utc_timestamp(column1, column2)
FROM VALUES (CAST('2024-07-01' AS timestamp), CAST('+19:00' AS string));
