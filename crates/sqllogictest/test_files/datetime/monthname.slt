# Scalar date input
query T
SELECT monthname(CAST('2024-03-15' AS DATE));
----
Mar

# All 12 months
query T
SELECT monthname(CAST('2024-01-15' AS DATE));
----
Jan

query T
SELECT monthname(CAST('2024-02-15' AS DATE));
----
Feb

query T
SELECT monthname(CAST('2024-03-15' AS DATE));
----
Mar

query T
SELECT monthname(CAST('2024-04-15' AS DATE));
----
Apr

query T
SELECT monthname(CAST('2024-05-15' AS DATE));
----
May

query T
SELECT monthname(CAST('2024-06-15' AS DATE));
----
Jun

query T
SELECT monthname(CAST('2024-07-15' AS DATE));
----
Jul

query T
SELECT monthname(CAST('2024-08-15' AS DATE));
----
Aug

query T
SELECT monthname(CAST('2024-09-15' AS DATE));
----
Sep

query T
SELECT monthname(CAST('2024-10-15' AS DATE));
----
Oct

query T
SELECT monthname(CAST('2024-11-15' AS DATE));
----
Nov

query T
SELECT monthname(CAST('2024-12-15' AS DATE));
----
Dec

# NULL handling
query T
SELECT monthname(CAST(NULL AS DATE));
----
NULL

# Array input
query T
SELECT monthname(d) FROM (VALUES (CAST('2024-01-01' AS DATE)), (CAST('2024-06-15' AS DATE)), (CAST('2024-12-31' AS DATE)), (CAST(NULL AS DATE))) AS t(d);
----
Jan
Jun
Dec
NULL

# Timestamp input: Spark coerces TIMESTAMP/TIMESTAMP_NTZ to DATE before evaluation
query T
SELECT monthname(CAST('2024-03-15 12:34:56' AS TIMESTAMP));
----
Mar

query T
SELECT monthname(CAST('2024-07-04 00:00:00' AS TIMESTAMP));
----
Jul

query T
SELECT monthname(CAST(NULL AS TIMESTAMP));
----
NULL

# Timestamp array input
query T
SELECT monthname(ts) FROM (VALUES
  (CAST('2024-01-15 01:02:03' AS TIMESTAMP)),
  (CAST('2024-08-20 10:20:30' AS TIMESTAMP)),
  (CAST('2024-11-30 23:59:59' AS TIMESTAMP)),
  (CAST(NULL AS TIMESTAMP))
) AS t(ts);
----
Jan
Aug
Nov
NULL

# TIMESTAMP_NTZ (Timestamp without timezone) — explicit Microsecond precision
query T
SELECT monthname(arrow_cast('2024-04-10 09:15:00', 'Timestamp(Microsecond, None)'));
----
Apr

# TIMESTAMP_NTZ — explicit Millisecond precision
query T
SELECT monthname(arrow_cast('2024-09-05 18:45:30', 'Timestamp(Millisecond, None)'));
----
Sep

# TIMESTAMP_NTZ — explicit Second precision
query T
SELECT monthname(arrow_cast('2024-02-29 00:00:00', 'Timestamp(Second, None)'));
----
Feb

# TIMESTAMP_NTZ — NULL handling
query T
SELECT monthname(arrow_cast(NULL, 'Timestamp(Microsecond, None)'));
----
NULL

# TIMESTAMP with timezone (Spark TIMESTAMP / LTZ) — coerces to Date32
query T
SELECT monthname(arrow_cast('2024-05-20 03:00:00', 'Timestamp(Nanosecond, Some("UTC"))'));
----
May

query T
SELECT monthname(arrow_cast('2024-10-31 23:59:59', 'Timestamp(Microsecond, Some("America/New_York"))'));
----
Oct

# Strings are implicitly cast to dates
query T
SELECT monthname(CAST('2008-02-20' AS STRING));
----
Feb

query T
SELECT monthname(CAST('2024-03-15 12:00:00' AS STRING));
----
Mar

query T
SELECT monthname(d) FROM (VALUES (CAST('2024-01-01' AS STRING)), (CAST(NULL AS STRING)), (CAST('2024-12-07 10:00:00' AS STRING))) AS t(d);
----
Jan
NULL
Dec

# Spark returns NULL for a malformed string when ANSI mode is off. DataFusion's
# string to date cast errors regardless of ANSI mode. ANSI-aware casting is
# tracked by https://github.com/apache/datafusion-spark/issues/88
# query T
# SELECT monthname('not-a-date'::STRING);
# ----
# NULL

# With ANSI mode on, Spark raises CAST_INVALID_INPUT for a malformed string
statement ok
set datafusion.execution.enable_ansi_mode = true;

query error Cannot cast string 'not-a-date' to value of Date32 type
SELECT monthname(CAST('not-a-date' AS STRING));

statement ok
set datafusion.execution.enable_ansi_mode = false;

# Error: wrong argument type (integer)
statement error Function 'monthname' requires Date, but received Int64
SELECT monthname(123);

# Error: no arguments
statement error 'monthname' does not support zero arguments
SELECT monthname();
