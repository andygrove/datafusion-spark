fcde2b2edba56bf408601fb721fe9b5c338d10ee429ea04fae5511b68fbf8fb9

query T
SELECT sha2(expr, 128::INT) FROM VALUES ('foo'), ('bar') AS t(expr);
----
NULL
NULL

