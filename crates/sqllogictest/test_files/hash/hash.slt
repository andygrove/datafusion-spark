# TIME is hashed as nanoseconds since midnight
query I
SELECT hash(TIME '12:00:00');
----
-1984942870

# Spark's day-time interval is Duration(Microsecond) in Arrow and is hashed as a
# BIGINT. DataFusion reads the literal INTERVAL '1' DAY as a calendar interval,
# so the Duration is built with arrow_cast. Spark 4.2.0: hash(INTERVAL '1' DAY).
query I
SELECT hash(arrow_cast(86400000000, 'Duration(Microsecond)'));
----
892267096

# Spark's year-month interval is Interval(YearMonth) and is hashed as an INT.
# Spark 4.2.0: hash(INTERVAL '14' MONTH).
query I
SELECT hash(arrow_cast('1 year 2 months', 'Interval(YearMonth)'));
----
335551368

# A calendar interval (Interval(MonthDayNano), from make_interval) is hashed as
# Spark 4.2.0's generated code does: the microseconds, then the months, without
# the days. So 0 and 1 days hash alike, as they do in Spark over a column, for
# example hash(make_interval(0, 0, 0, CAST(id AS INT))) FROM range(2). Spark's
# interpreted path, which it uses to constant-fold a literal, includes the days
# and gives other values. SPARK-58236 includes the days from Spark 4.3. Spark
# folds these VALUES rows with the interpreted path, so the PySpark runner skips
# this record.
skipif spark
query I
SELECT hash(make_interval(0, 0, 0, CAST(d AS INT))) FROM (VALUES (0), (1)) AS t(d);
----
1081828689
1081828689

# DataFusion types the literal INTERVAL '1' DAY as Interval(MonthDayNano), so it
# takes the calendar-interval path above and hashes like a zero interval. Spark
# 4.2.0 types it as a day-time interval and returns 892267096, the Duration case
# above, so the PySpark runner skips this record.
skipif spark
query II
SELECT hash(INTERVAL '1' DAY), hash(make_interval(0, 0, 0, 0));
----
1081828689 1081828689

# Spark requires at least one argument
statement error does not support zero arguments
SELECT hash();
