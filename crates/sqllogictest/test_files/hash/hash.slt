-912918097
42
42

query I
SELECT hash(CASE WHEN i = 2 THEN NULL ELSE named_struct('a', i, 'b', CAST(i AS VARCHAR)) END)
FROM (SELECT CAST(column1 AS INT) AS i FROM (VALUES (1), (2), (3)));
