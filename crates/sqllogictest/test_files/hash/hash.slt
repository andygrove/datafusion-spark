# Tests for Spark-compatible hash (32-bit Murmur3, seed 42)
# Reference: https://spark.apache.org/docs/latest/api/sql/index.html#hash
# Expected values were checked against Spark 4.2.0 (PySpark).

# Int32

query I
SELECT hash(1::INT);
----
-559580957

query I
SELECT hash(0::INT);
----
933211791

query I
SELECT hash((-1)::INT);
----
-1604776387

query I
SELECT hash(2147483647::INT);
----
133916647

query I
SELECT hash((-2147483648)::INT);
----
723455942

