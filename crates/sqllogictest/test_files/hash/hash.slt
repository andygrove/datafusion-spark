# Table data (VALUES integers are Int64, which hash as 8 bytes)
statement ok
CREATE TABLE hash_t AS VALUES (1, 'hello'), (NULL, 'bar'), (0, NULL);

# xfail spark: VALUES integers are BIGINT in DataFusion and INT in Spark, so they hash differently (https://github.com/apache/datafusion-spark/issues/97)
query I
SELECT hash(column1) FROM hash_t;
----
-1712319331
42
-1670924195

query I
SELECT hash(column2) FROM hash_t;
----
-1008564952
-1808790533
42

