# Timestamps hash as BIGINT microseconds since the epoch, whatever the Arrow unit.
# DataFusion's TIMESTAMP literals are nanoseconds. Spark values are with
# spark.sql.session.timeZone=UTC.

query I
SELECT hash(TIMESTAMP '2020-01-01 00:00:00');
----
-1486022740

query I
SELECT hash(arrow_cast(TIMESTAMP '2020-01-01 00:00:00', 'Timestamp(Second, None)'));
