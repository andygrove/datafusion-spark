-1486022740

query I
SELECT hash(arrow_cast(TIMESTAMP '2020-01-01 00:00:00', 'Timestamp(Microsecond, None)'));
----
-1486022740

query I
SELECT hash(arrow_cast(TIMESTAMP '2020-01-01 00:00:00', 'Timestamp(Nanosecond, Some("UTC"))'));
----
-1486022740

query I
SELECT hash([TIMESTAMP '2020-01-01 00:00:00']);
----
-1486022740

# -1 ns floors to -1 us (Spark: timestamp_micros(-1)); -1 s is -1000000 us
