SELECT hash(column1) FROM (VALUES ([CAST(1 AS INT), CAST(2 AS INT)]), (NULL), ([NULL, CAST(3 AS INT)]), ([]::ARRAY<INT>));
----
-222940379
42
-1823081949
42

