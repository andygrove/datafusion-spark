query I
SELECT bitmap_bit_position(CAST(1 AS TINYINT));
----
0

query I
SELECT bitmap_bit_position(CAST(3 AS TINYINT));
----
2

query I
SELECT bitmap_bit_position(CAST(7 AS TINYINT));
----
6

query I
SELECT bitmap_bit_position(CAST(15 AS TINYINT));
----
14

query I
SELECT bitmap_bit_position(CAST(-1 AS TINYINT));
----
1

query I
SELECT bitmap_bit_position(CAST(256 AS SMALLINT));
----
255

query I
SELECT bitmap_bit_position(CAST(1024 AS SMALLINT));
----
1023

query I
SELECT bitmap_bit_position(CAST(-32768 AS SMALLINT));
----
0

query I
SELECT bitmap_bit_position(CAST(16384 AS SMALLINT));
----
16383

query I
SELECT bitmap_bit_position(CAST(-1 AS SMALLINT));
----
1

query I
SELECT bitmap_bit_position(CAST(65536 AS INT));
----
32767

query I
SELECT bitmap_bit_position(CAST(1048576 AS INT));
----
32767

query I
SELECT bitmap_bit_position(CAST(-2147483648 AS INT));
----
0

