query R
SELECT expm1(CAST(0 AS INT));
----
0

query R
SELECT expm1(CAST(1 AS INT));
----
1.718281828459045

query R
SELECT expm1(a) FROM (VALUES (CAST(0 AS INT)), (CAST(1 AS INT))) AS t(a);
----
0
1.718281828459045

query R
SELECT expm1(CAST(0.0 AS double));
----
0
