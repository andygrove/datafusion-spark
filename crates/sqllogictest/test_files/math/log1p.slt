# Basic values and a negative input within the domain
query R
SELECT log1p(CAST(0.5 AS DOUBLE));
----
0.4054651081081644

query R
SELECT log1p(CAST(1.0 AS DOUBLE));
----
0.6931471805599453

query R
SELECT log1p(-CAST(0.5 AS DOUBLE));
----
-0.6931471805599453

# A value immediately greater than the boundary -1
query R
SELECT log1p(-CAST(0.9999999999999999 AS DOUBLE));
----
-36.7368005696771

# The boundary and values outside the domain return NULL
query R
SELECT log1p(-CAST(1.0 AS DOUBLE));
----
NULL

query R
SELECT log1p(-CAST(2.0 AS DOUBLE));
----
NULL

query R
SELECT log1p(CAST('-Infinity' AS DOUBLE));
----
NULL

# NULL input returns NULL
query R
SELECT log1p(CAST(NULL AS DOUBLE));
----
NULL

# Evaluate multiple values in a column
query R
SELECT log1p(a)
FROM (VALUES
    (CAST(0.0 AS DOUBLE)),
    (CAST(0.5 AS DOUBLE)),
    (-CAST(0.5 AS DOUBLE)),
    (-CAST(1.0 AS DOUBLE))
) AS t(a);
----
0
0.4054651081081644
-0.6931471805599453
NULL

# Small inputs retain precision near zero
query B
SELECT log1p(CAST(1e-300 AS DOUBLE)) = CAST(1e-300 AS DOUBLE);
----
true

query B
SELECT log1p(CAST(1e-20 AS DOUBLE)) = CAST(1e-20 AS DOUBLE);
----
true

# NaN and positive infinity are preserved
query R
SELECT log1p(CAST('NaN' AS DOUBLE));
----
NaN

query R
SELECT log1p(CAST('Infinity' AS DOUBLE));
----
Infinity

# Integer, float, decimal, and string inputs
query R
SELECT log1p(CAST(1 AS INT));
----
0.6931471805599453

query R
SELECT log1p(CAST(0.5 AS FLOAT));
----
0.4054651081081644

query R
SELECT log1p(CAST(0.5 AS DECIMAL(10, 2)));
----
0.4054651081081644

query R
SELECT log1p('0.5');
----
0.4054651081081644
