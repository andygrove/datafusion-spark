query IIIII
SELECT factorial(5) AS i64_literal,
       factorial(CAST(5 AS TINYINT)) AS i8,
       factorial(CAST(5 AS SMALLINT)) AS i16,
       factorial(CAST(5 AS BIGINT)) AS i64,
       factorial(NULL) AS null_input;
----
120 120 120 120 NULL

query I
SELECT factorial(a) FROM VALUES (-CAST(1 AS BIGINT)), (CAST(0 AS BIGINT)), (CAST(20 AS BIGINT)), (CAST(21 AS BIGINT)), (NULL) AS t(a);
