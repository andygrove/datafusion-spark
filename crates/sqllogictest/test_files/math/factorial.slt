## Original Query: SELECT factorial(5);
## PySpark 3.5.5 Result: {'factorial(5)': 120, 'typeof(factorial(5))': 'bigint', 'typeof(5)': 'int'}
query I
SELECT factorial(CAST(5 AS INT));
----
120

query I
SELECT factorial(a)
FROM VALUES
    (-CAST(1 AS INT)),
    (CAST(0 AS INT)), (CAST(1 AS INT)), (CAST(2 AS INT)), (CAST(3 AS INT)), (CAST(4 AS INT)), (CAST(5 AS INT)), (CAST(6 AS INT)), (CAST(7 AS INT)), (CAST(8 AS INT)), (CAST(9 AS INT)), (CAST(10 AS INT)),
    (CAST(11 AS INT)), (CAST(12 AS INT)), (CAST(13 AS INT)), (CAST(14 AS INT)), (CAST(15 AS INT)), (CAST(16 AS INT)), (CAST(17 AS INT)), (CAST(18 AS INT)), (CAST(19 AS INT)), (CAST(20 AS INT)),
    (CAST(21 AS INT)),
    (NULL) AS t(a);
