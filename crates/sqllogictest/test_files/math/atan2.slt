# standard angles in radians
query R
SELECT atan2(0, 0);
----
0

query R
SELECT atan2(0, 1);
----
0

# all four quadrants (atan2 is quadrant-aware via the signs of both arguments)
query R
SELECT atan2(1, 1);
----
0.7853981633974483

query R
SELECT atan2(1, -1);
----
2.356194490192345

query R
SELECT atan2(-1, -1);
----
-2.356194490192345

query R
SELECT atan2(-1, 1);
----
-0.7853981633974483

# on the axes
query R
SELECT atan2(1, 0);
----
1.5707963267948966

# negative x-axis: atan2 range extends to pi (atan only reaches +/- pi/2)
query R
SELECT atan2(0, -1);
----
3.141592653589793

# NULL if either argument is NULL
query R
SELECT atan2(CAST(NULL AS double), CAST(1.0 AS double));
----
NULL

query R
SELECT atan2(CAST(1.0 AS double), CAST(NULL AS double));
----
NULL

# NaN: any NaN input yields NaN (for atan2, NaN wins even over Infinity)
query R
SELECT atan2(CAST('NaN' AS double), CAST(1.0 AS double));
----
NaN

query R
SELECT atan2(CAST(1.0 AS double), CAST('NaN' AS double));
----
NaN

query R
SELECT atan2(CAST('NaN' AS double), CAST('NaN' AS double));
----
NaN

query R
SELECT atan2(CAST('NaN' AS double), CAST('Infinity' AS double));
----
NaN

# NULL beats every special value (validity is checked before the value)
query R
SELECT atan2(CAST(NULL AS double), CAST('Infinity' AS double));
----
NULL

# both infinite: quadrant set by the signs (+/- pi/4, +/- 3pi/4)
query R
SELECT atan2(CAST('Infinity' AS double), CAST('Infinity' AS double));
----
0.7853981633974483

query R
SELECT atan2(CAST('-Infinity' AS double), CAST('Infinity' AS double));
----
-0.7853981633974483

query R
SELECT atan2(CAST('Infinity' AS double), CAST('-Infinity' AS double));
----
2.356194490192345

query R
SELECT atan2(CAST('-Infinity' AS double), CAST('-Infinity' AS double));
----
-2.356194490192345

# one infinite argument
query R
SELECT atan2(CAST('Infinity' AS double), CAST(1.0 AS double));
----
1.5707963267948966

query R
SELECT atan2(CAST('-Infinity' AS double), CAST(1.0 AS double));
----
-1.5707963267948966

query R
SELECT atan2(CAST(1.0 AS double), CAST('Infinity' AS double));
----
0

query R
SELECT atan2(CAST(1.0 AS double), CAST('-Infinity' AS double));
----
3.141592653589793

query R
SELECT atan2(-CAST(1.0 AS double), CAST('-Infinity' AS double));
----
-3.141592653589793

# Spark adds 0.0 to both arguments, turning -0.0 into 0.0
query R
SELECT atan2(-CAST(0.0 AS double), -CAST(1.0 AS double));
----
3.141592653589793

query R
SELECT atan2(-CAST(0.0 AS double), CAST(1.0 AS double));
----
0

query R
SELECT atan2(CAST(0.0 AS double), -CAST(0.0 AS double));
----
0

query R
SELECT atan2(-CAST(0.0 AS double), -CAST(0.0 AS double));
----
0

# array path, including a NULL row and signed zero
query R
SELECT atan2(a, b) FROM (VALUES (CAST(0.0 AS double), CAST(1.0 AS double)), (CAST(1.0 AS double), CAST(1.0 AS double)), (CAST(NULL AS double), CAST(1.0 AS double)), (-CAST(0.0 AS double), -CAST(1.0 AS double))) AS t(a, b);
----
0
0.7853981633974483
NULL
3.141592653589793
