## Original Query: SELECT shiftleft(2, 1);
## PySpark 3.5.5 Result: {'shiftleft(2, 1)': 4, 'typeof(shiftleft(2, 1))': 'int', 'typeof(2)': 'int', 'typeof(1)': 'int'}

# Basic shiftleft tests
query I
SELECT shiftleft(CAST(2 AS int), CAST(1 AS int));
----
4

query I
SELECT shiftleft(CAST(1 AS int), CAST(2 AS int));
----
4

query I
SELECT shiftleft(CAST(3 AS int), CAST(3 AS int));
----
24

# Different data types
query I
SELECT shiftleft(CAST(2 AS bigint), CAST(1 AS int));
----
4

query I
SELECT shiftleft(CAST(1 AS bigint), CAST(2 AS int));
----
4

query I
SELECT shiftleft(CAST(2 AS int), CAST(1 AS bigint));
----
4

# Large shifts (should handle modulo correctly)
query I
SELECT shiftleft(CAST(1 AS int), CAST(32 AS int));
----
1

query I
SELECT shiftleft(CAST(2 AS int), CAST(33 AS int));
----
4

query I
SELECT shiftleft(CAST(3 AS int), CAST(64 AS int));
----
3

# Negative shifts
query I
SELECT shiftleft(CAST(4 AS int), -CAST(1 AS int));
----
0

query I
SELECT shiftleft(CAST(8 AS int), -CAST(2 AS int));
----
0

query I
SELECT shiftleft(CAST(16 AS int), -CAST(3 AS int));
----
0

# Zero shifts
query I
SELECT shiftleft(CAST(5 AS int), CAST(0 AS int));
----
5

query I
SELECT shiftleft(CAST(0 AS int), CAST(5 AS int));
----
0

# Edge cases
query I
SELECT shiftleft(CAST(2147483647 AS int), CAST(1 AS int));
----
-2

query I
SELECT shiftleft(-CAST(1 AS int), CAST(1 AS int));
----
-2

# Multiple values in a table
query I
SELECT shiftleft(value, shift) FROM (VALUES (1, 1), (2, 2), (3, 3), (4, 4)) AS t(value, shift);
----
2
8
24
64

# Null handling
query I
SELECT shiftleft(CAST(NULL AS int), CAST(1 AS int));
----
NULL

query I
SELECT shiftleft(CAST(1 AS int), CAST(NULL AS int));
----
NULL

query I
SELECT shiftleft(CAST(NULL AS int), CAST(NULL AS int));
----
NULL

query I
select shiftleft(CAST(3 AS int),-31);
----
6

query I
select shiftleft(CAST(3 AS int),-32);
----
3

# i32 + nulls
query IT
SELECT
	shiftleft(CAST(value AS INT), shift),
	arrow_typeof(shiftleft(CAST(value AS INT), shift))
FROM VALUES
(1, 1),
(2, 2),
(3, 3),
(4, 4),
(null, 2),
(8, null)
t(value, shift)
----
2 Int32
8 Int32
24 Int32
64 Int32
NULL Int32
NULL Int32

# big shifts
query IT
SELECT
	shiftleft(CAST(value AS INT), shift),
	arrow_typeof(shiftleft(CAST(value AS INT), shift))
FROM VALUES
(1, 32),
(2, 33),
(3, 64)
t(value, shift)
----
1 Int32
4 Int32
3 Int32

# negative shift
query IT
SELECT
	shiftleft(CAST(value AS INT), shift),
	arrow_typeof(shiftleft(CAST(value AS INT), shift))
FROM VALUES
(4, -1),
(8, -2),
(16, -3)
t(value, shift)
----
0 Int32
0 Int32
0 Int32

# i64 value
query IT
SELECT
	shiftleft(CAST(value AS BIGINT), shift),
	arrow_typeof(shiftleft(CAST(value AS BIGINT), shift))
FROM VALUES (1, 1), (2, 2), (3, 3) t(value, shift)
----
2 Int64
8 Int64
24 Int64

# u32 value
query IT
SELECT
	shiftleft(arrow_cast(value, 'UInt32'), shift),
	arrow_typeof(shiftleft(arrow_cast(value, 'UInt32'), shift))
FROM VALUES (1, 1), (2, 2), (3, 3) t(value, shift)
----
2 UInt32
8 UInt32
24 UInt32

# u64 value
query IT
SELECT
	shiftleft(arrow_cast(value, 'UInt64'), shift),
	arrow_typeof(shiftleft(arrow_cast(value, 'UInt64'), shift))
FROM VALUES (1, 1), (2, 2), (3, 3) t(value, shift)
----
2 UInt64
8 UInt64
24 UInt64

# pure null handling
query IT
SELECT shiftleft(null, 1), arrow_typeof(shiftleft(null, 1));
----
NULL Int32

query IT
SELECT shiftleft(null, null), arrow_typeof(shiftleft(null, null));
----
NULL Int32

query IT
SELECT shiftleft(CAST(1 AS bigint), null), arrow_typeof(shiftleft(CAST(1 AS bigint), null));
----
NULL Int64
