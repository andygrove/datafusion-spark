## Original Query: SELECT greatest(10, 9, 2, 4, 3);
## PySpark 3.5.5 Result: {'greatest(10, 9, 2, 4, 3)': 10, 'typeof(greatest(10, 9, 2, 4, 3))': 'int', 'typeof(10)': 'int', 'typeof(9)': 'int', 'typeof(2)': 'int', 'typeof(4)': 'int', 'typeof(3)': 'int'}
query I
SELECT greatest(CAST(10 AS int), CAST(9 AS int), CAST(2 AS int), CAST(4 AS int), CAST(3 AS int));
----
10

# NULLs are skipped; the result is NULL only if every argument is NULL
query III
SELECT greatest(CAST(1 AS int), CAST(NULL AS int), CAST(3 AS int)), greatest(CAST(NULL AS int), CAST(2 AS int)), greatest(CAST(NULL AS int), CAST(NULL AS int));
----
3 2 NULL

query ?
SELECT greatest(NULL, NULL);
----
NULL

# Integers widen to the widest integer type
query I
SELECT greatest(CAST(1 AS tinyint), CAST(2 AS smallint));
----
2

query T
SELECT arrow_typeof(greatest(CAST(1 AS tinyint), CAST(2 AS smallint)));
----
Int16

query I
SELECT greatest(CAST(1 AS int), CAST(3000000000 AS bigint));
----
3000000000

# An integer and a DOUBLE widen to DOUBLE
query R
SELECT greatest(CAST(1 AS int), CAST(2.5 AS double));
----
2.5

query T
SELECT arrow_typeof(greatest(CAST(1 AS int), CAST(2.5 AS double)));
----
Float64

# NaN is greater than every other value, including Infinity
query RRR
SELECT greatest(CAST('NaN' AS double), CAST('Infinity' AS double)), greatest(CAST(1 AS double), CAST('NaN' AS double)), greatest(CAST('-Infinity' AS double), CAST(NULL AS double));
----
NaN NaN -Infinity

query R
SELECT greatest(CAST('NaN' AS float), CAST(1 AS float));
----
NaN

# -0.0 equals 0.0 and the first of equal values wins. The sign of a zero shows in its string
# form, which starts with '-' only for -0.0.
query BB
SELECT CAST(greatest(CAST('-0.0' AS double), CAST(0.0 AS double)) AS STRING) LIKE '-%', CAST(greatest(CAST(0.0 AS double), CAST('-0.0' AS double)) AS STRING) LIKE '-%';
----
true false

# Decimals
query R
SELECT greatest(CAST(1.5 AS decimal(2,1)), CAST(2 AS int));
----
2.0

query T
SELECT arrow_typeof(greatest(CAST(1.5 AS decimal(2,1)), CAST(2 AS int)));
----
Decimal128(11, 1)

query T
SELECT arrow_typeof(greatest(CAST(1 AS decimal(5,2)), CAST(1 AS bigint)));
----
Decimal128(22, 2)

query T
SELECT arrow_typeof(greatest(CAST(1 AS decimal(38,10)), CAST(1 AS decimal(38,0))));
----
Decimal128(38, 0)

# The fractional digits that do not fit are rounded away
# xfail spark<4.0: intended: Spark 3.5 picks DECIMAL(38, 10) as the wider type and keeps the fraction, and datafusion-spark follows Spark 4
query R
SELECT greatest(CAST(1.5 AS decimal(38,10)), CAST(1 AS decimal(38,0)));
----
2

# xfail spark<4.0: intended: Spark 3.5 picks DECIMAL(38, 10) as the wider type and returns NULL for the value that does not fit, and datafusion-spark follows Spark 4
query R
SELECT greatest(CAST(1 AS decimal(38,10)), CAST('12345678901234567890123456789' AS decimal(38,0)));
----
12345678901234567890123456789

# A decimal and a DOUBLE widen to DOUBLE
query R
SELECT greatest(CAST(1.5 AS decimal(2,1)), CAST(2.5 AS double));
----
2.5

query T
SELECT arrow_typeof(greatest(CAST(1.5 AS decimal(2,1)), CAST(2.5 AS double)));
----
Float64

# Strings
query TTT
SELECT greatest('abc', 'abd', 'ab'), greatest('a', 'b', NULL), greatest('', 'a');
----
abd b a

# Booleans
query B
SELECT greatest(true, false);
----
true

# Binary
query ?
SELECT greatest(X'01', X'0102');
----
0102

# Dates and timestamps; a date and a timestamp widen to the timestamp
query D
SELECT greatest(DATE '2024-01-01', DATE '2023-12-31', CAST(NULL AS date));
----
2024-01-01

query P
SELECT greatest(DATE '2024-01-01', TIMESTAMP '2023-01-01 10:00:00');
----
2024-01-01T00:00:00

query P
SELECT greatest(TIMESTAMP '2024-01-01 10:00:00', TIMESTAMP '2024-01-01 10:00:01');
----
2024-01-01T10:00:01

# Arrays compare element by element and then by length, a NULL element is smaller than any
# value, and elements widen
query ??
SELECT greatest(array(1, 2), array(1, 2, 3)), greatest(array(1, NULL), array(1, 0));
----
[1, 2, 3] [1, 0]

query ?
SELECT greatest(array(1), array(CAST(1.5 AS double)));
----
[1.5]

query ?
SELECT greatest(array(CAST('NaN' AS double)), array(CAST(1 AS double)));
----
[NaN]

# Structs compare field by field
query ?
SELECT greatest(named_struct('a', 1, 'b', 2), named_struct('a', 1, 'b', 3));
----
{a: 1, b: 3}

# Columns
statement ok
CREATE TABLE t AS VALUES
  (CAST(1 AS int), CAST(2 AS int), CAST('NaN' AS double), CAST(1 AS double), 'b'),
  (CAST(5 AS int), CAST(NULL AS int), -CAST(1 AS double), CAST(NULL AS double), 'a'),
  (CAST(NULL AS int), CAST(NULL AS int), CAST(NULL AS double), CAST(NULL AS double), NULL),
  (CAST(NULL AS int), CAST(7 AS int), CAST('Infinity' AS double), CAST('NaN' AS double), 'c');

query IIRRT
SELECT greatest(column1, column2), greatest(column1, CAST(3 AS int), column2), greatest(column3, column4), greatest(column3, CAST(0 AS double)), greatest(column5, 'b') FROM t;
----
2 3 NaN NaN b
5 5 -1 0 b
NULL 3 NULL 0 b
7 7 NaN Infinity c

# A constant first argument, followed by columns. A NULL constant is skipped.
query IIIR
SELECT greatest(CAST(3 AS int), column1), greatest(CAST(NULL AS int), column1), greatest(CAST(NULL AS int), column1, column2), greatest(CAST(0 AS double), column3) FROM t;
----
3 1 2 NaN
5 5 5 0
3 NULL NULL 0
3 NULL 7 Infinity

statement ok
DROP TABLE t;

# Errors

# At least two arguments
query error \[WRONG_NUM_ARGS\.WITHOUT_SUGGESTION\] The `greatest` requires > 1 parameters but the actual number is 1\. Please, refer to 'https://spark\.apache\.org/docs/latest/sql-ref-functions\.html' for a fix\. SQLSTATE: 42605
SELECT greatest(CAST(1 AS int));

query error
SELECT greatest();

# Strings are not promoted
query error \[DATATYPE_MISMATCH\.DATA_DIFF_TYPES\] Input to `greatest` should all be the same type, but it's \["INT", "STRING"\]\. SQLSTATE: 42K09
SELECT greatest(CAST(1 AS int), 'a');

query error \[DATATYPE_MISMATCH\.DATA_DIFF_TYPES\] Input to `greatest` should all be the same type, but it's \["DATE", "STRING"\]
SELECT greatest(DATE '2024-01-01', '2025-01-01');

query error \[DATATYPE_MISMATCH\.DATA_DIFF_TYPES\] Input to `greatest` should all be the same type, but it's \["BOOLEAN", "INT"\]
SELECT greatest(true, CAST(1 AS int));

query error \[DATATYPE_MISMATCH\.DATA_DIFF_TYPES\]
SELECT greatest(array(1), CAST(1 AS int));

query error \[DATATYPE_MISMATCH\.DATA_DIFF_TYPES\]
SELECT greatest(named_struct('a', 1), named_struct('b', 1));

# Maps cannot be ordered
query error \[DATATYPE_MISMATCH\.INVALID_ORDERING_TYPE\] The `greatest` does not support ordering on type "MAP<INT, INT>"\. SQLSTATE: 42K09
SELECT greatest(map(CAST(1 AS int), CAST(2 AS int)), map(CAST(1 AS int), CAST(3 AS int)));

# Intervals cannot be ordered
query error \[DATATYPE_MISMATCH\.INVALID_ORDERING_TYPE\] The `greatest` does not support ordering on type "INTERVAL"\. SQLSTATE: 42K09
SELECT greatest(make_interval(1), make_interval(2));

query error \[DATATYPE_MISMATCH\.INVALID_ORDERING_TYPE\] The `greatest` does not support ordering on type "ARRAY<INTERVAL>"\. SQLSTATE: 42K09
SELECT greatest(array(make_interval(1)), array(make_interval(2)));

# An integer and a FLOAT widen to FLOAT with ANSI mode off, and to DOUBLE with it on
query T
SELECT arrow_typeof(greatest(CAST(1 AS int), CAST(2.5 AS float)));
----
Float32

statement ok
set datafusion.execution.enable_ansi_mode = true;

query T
SELECT arrow_typeof(greatest(CAST(1 AS int), CAST(2.5 AS float)));
----
Float64

query R
SELECT greatest(CAST(1 AS bigint), CAST(2.5 AS float));
----
2.5

statement ok
set datafusion.execution.enable_ansi_mode = false;
