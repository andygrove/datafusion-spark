## Original Query: SELECT abs(-1);
## PySpark 3.5.5 Result: {'abs(-1)': 1, 'typeof(abs(-1))': 'int', 'typeof(-1)': 'int'}

# Scalar input
## Scalar input: signed int and NULL
query IIIIR
SELECT abs(-CAST(127 AS TINYINT)), abs(-CAST(32767 AS SMALLINT)), abs(-CAST(2147483647 AS INT)), abs(-CAST(9223372036854775807 AS BIGINT)), abs(NULL);
----
127 32767 2147483647 9223372036854775807 NULL

## Scalar input: signed int minimal values
## See https://github.com/apache/datafusion/issues/18794 for operator precedence
query IIII
select abs(CAST(-128 AS TINYINT)), abs(CAST(-32768 AS SMALLINT)), abs(CAST(-2147483648 AS INT)), abs(CAST(-9223372036854775808 AS BIGINT));
----
-128 -32768 -2147483648 -9223372036854775808

## Scalar input: Spark ANSI mode, signed int minimal values
statement ok
set datafusion.execution.enable_ansi_mode = true;

query error
select abs(CAST(-128 AS TINYINT));
----
DataFusion error: Arrow error: Compute error: [ARITHMETIC_OVERFLOW] overflow. If necessary set "spark.sql.ansi.enabled" to "false" to bypass this error. SQLSTATE: 22003


query error
select abs(CAST(-32768 AS SMALLINT));
----
DataFusion error: Arrow error: Compute error: [ARITHMETIC_OVERFLOW] overflow. If necessary set "spark.sql.ansi.enabled" to "false" to bypass this error. SQLSTATE: 22003


query error
select abs(CAST(-2147483648 AS INT));
----
DataFusion error: Arrow error: Compute error: [ARITHMETIC_OVERFLOW] overflow. If necessary set "spark.sql.ansi.enabled" to "false" to bypass this error. SQLSTATE: 22003


query error
select abs(CAST(-9223372036854775808 AS BIGINT));
----
DataFusion error: Arrow error: Compute error: [ARITHMETIC_OVERFLOW] overflow. If necessary set "spark.sql.ansi.enabled" to "false" to bypass this error. SQLSTATE: 22003


statement ok
set datafusion.execution.enable_ansi_mode = false;

## Scalar input: float, NULL, NaN, -0, infinity, -infinity
query RRRRRRRRRRRR
SELECT abs(-CAST(1.0 AS FLOAT)), abs(CAST(0. AS FLOAT)), abs(-CAST(0. AS FLOAT)), abs(-CAST(0 AS FLOAT)), abs(CAST(NULL AS FLOAT)), abs(CAST('NaN' AS FLOAT)), abs(CAST('inf' AS FLOAT)), abs(CAST('+inf' AS FLOAT)), abs(CAST('-inf' AS FLOAT)), abs(CAST('infinity' AS FLOAT)), abs(CAST('+infinity' AS FLOAT)), abs(CAST('-infinity' AS FLOAT));
----
1 0 0 0 NULL NaN Infinity Infinity Infinity Infinity Infinity Infinity

## Scalar input: double, NULL, NaN, -0, infinity, -infinity
query RRRRRRRRRRRR
SELECT abs(-CAST(1.0 AS DOUBLE)), abs(CAST(0. AS DOUBLE)), abs(-CAST(0. AS DOUBLE)), abs(-CAST(0 AS DOUBLE)), abs(CAST(NULL AS DOUBLE)), abs(CAST('NaN' AS DOUBLE)), abs(CAST('inf' AS DOUBLE)), abs(CAST('+inf' AS DOUBLE)), abs(CAST('-inf' AS DOUBLE)), abs(CAST('infinity' AS DOUBLE)), abs(CAST('+infinity' AS DOUBLE)), abs(CAST('-infinity' AS DOUBLE));
----
1 0 0 0 NULL NaN Infinity Infinity Infinity Infinity Infinity Infinity

## Scalar input: decimal128
query RRR
SELECT abs(CAST(('-99999999.99') AS DECIMAL(10, 2))), abs(CAST(0 AS DECIMAL(10, 2))), abs(CAST(NULL AS DECIMAL(10, 2)));
----
99999999.99 0.00 NULL

# xfail spark: intended: Spark's abs rounds DECIMAL to 34 digits and overflows, DataFusion returns the exact value
query RRR
SELECT abs(CAST(('-9999999999999999999999999999.9999999999') AS DECIMAL(38, 10))), abs(CAST(0 AS DECIMAL(38, 10))), abs(CAST(NULL AS DECIMAL(38, 10)));
----
9999999999999999999999999999.9999999999 0.0000000000 NULL

## Scalar input: decimal256
query RRR
SELECT abs(CAST(('-99999999999999999999999999999999999999.99') AS DECIMAL(40, 2))), abs(CAST(0 AS DECIMAL(40, 2))), abs(CAST(NULL AS DECIMAL(40, 2)));
----
99999999999999999999999999999999999999.99 0.00 NULL

query RRR
SELECT abs(CAST(('-999999999999999999999999999999999999999999999999999999999999999999.9999999999') AS DECIMAL(76, 10))), abs(CAST(0 AS DECIMAL(76, 10))), abs(CAST(NULL AS DECIMAL(76, 10)));
----
999999999999999999999999999999999999999999999999999999999999999999.9999999999 0.0000000000 NULL


# Array input
## Array input: signed int, signed int minimal values and NULL
query I
SELECT abs(a) FROM (VALUES (-CAST(127 AS TINYINT)), (CAST(-128 AS TINYINT)), (NULL)) AS t(a);
----
127
-128
NULL

query I
select abs(a) FROM (VALUES (-CAST(32767 AS SMALLINT)), (CAST(-32768 AS SMALLINT)), (NULL)) AS t(a);
----
32767
-32768
NULL

query I
select abs(a) FROM (VALUES (-CAST(2147483647 AS INT)), (CAST(-2147483648 AS INT)), (NULL)) AS t(a);
----
2147483647
-2147483648
NULL

query I
select abs(a) FROM (VALUES (-CAST(9223372036854775807 AS BIGINT)), (CAST(-9223372036854775808 AS BIGINT)), (NULL)) AS t(a);
----
9223372036854775807
-9223372036854775808
NULL

