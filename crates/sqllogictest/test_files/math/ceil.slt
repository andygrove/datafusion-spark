# Tests for Spark-compatible ceil function.
# Spark semantics differ from DataFusion's built-in ceil in two ways:
#   1. Return type: Spark returns Int64 for float/integer inputs;
#      DataFusion returns the same float type (e.g. ceil(CAST(1.5 AS DOUBLE)) -> DOUBLE in DF, BIGINT in Spark)
#   2. Decimal precision: Spark adjusts precision to (p - s + 1) for Decimal128(p, s) with scale > 0;
#      DataFusion preserves the original precision and scale
#
# Example: SELECT ceil(CAST(1.50 AS DECIMAL(10,2)))
#   Spark:      returns Decimal(9, 0) value 2
#   DataFusion: returns Decimal(10, 2) value 2.00

## Original Query: SELECT ceil(-0.1);
## PySpark 3.5.5 Result: {'CEIL(-0.1)': Decimal('0'), 'typeof(CEIL(-0.1))': 'decimal(1,0)', 'typeof(-0.1)': 'decimal(1,1)'}
query RT
SELECT ceil(-CAST(0.1 AS decimal(1,1))), arrow_typeof(ceil(-CAST(0.1 AS decimal(1,1))));
----
0 Decimal128(1, 0)

## Original Query: SELECT ceil(3.1411, -3);
## PySpark 3.5.5 Result: {'ceil(3.1411, -3)': Decimal('1000'), 'typeof(ceil(3.1411, -3))': 'decimal(4,0)', 'typeof(3.1411)': 'decimal(5,4)', 'typeof(-3)': 'int'}
## TODO: 2-argument ceil(value, scale) is not yet implemented
#query
#SELECT ceil(3.1411::decimal(5,4), -3::int);

## Original Query: SELECT ceil(3.1411, 3);
## PySpark 3.5.5 Result: {'ceil(3.1411, 3)': Decimal('3.142'), 'typeof(ceil(3.1411, 3))': 'decimal(5,3)', 'typeof(3.1411)': 'decimal(5,4)', 'typeof(3)': 'int'}
## TODO: 2-argument ceil(value, scale) is not yet implemented
#query
#SELECT ceil(3.1411::decimal(5,4), 3::int);

## Original Query: SELECT ceil(5);
## PySpark 3.5.5 Result: {'CEIL(5)': 5, 'typeof(CEIL(5))': 'bigint', 'typeof(5)': 'int'}
query IT
SELECT ceil(CAST(5 AS int)), arrow_typeof(ceil(CAST(5 AS int)));
----
5 Int64

# Scalar input: float64 returns bigint
query IIIIIIIT
SELECT ceil(CAST(125.2345 AS DOUBLE)), ceil(CAST(15.0001 AS DOUBLE)), ceil(CAST(0.1 AS DOUBLE)), ceil(-CAST(0.9 AS DOUBLE)), ceil(-CAST(1.1 AS DOUBLE)), ceil(CAST(123.0 AS DOUBLE)), ceil(CAST(NULL AS DOUBLE)), arrow_typeof(ceil(CAST(125.2345 AS DOUBLE)));
----
126 16 1 0 -1 123 NULL Int64

# Scalar input: float32 returns bigint
query IIIIIIIT
SELECT ceil(CAST(125.2345 AS FLOAT)), ceil(CAST(15.0001 AS FLOAT)), ceil(CAST(0.1 AS FLOAT)), ceil(-CAST(0.9 AS FLOAT)), ceil(-CAST(1.1 AS FLOAT)), ceil(CAST(123.0 AS FLOAT)), ceil(CAST(NULL AS FLOAT)), arrow_typeof(ceil(CAST(125.2345 AS FLOAT)));
----
126 16 1 0 -1 123 NULL Int64

# Scalar input: integer types all return bigint
query IIIT
SELECT ceil(CAST(5 AS TINYINT)), ceil(-CAST(3 AS TINYINT)), ceil(CAST(NULL AS TINYINT)), arrow_typeof(ceil(CAST(5 AS TINYINT)));
----
5 -3 NULL Int64

query IIIT
SELECT ceil(CAST(5 AS SMALLINT)), ceil(-CAST(3 AS SMALLINT)), ceil(CAST(NULL AS SMALLINT)), arrow_typeof(ceil(CAST(5 AS SMALLINT)));
----
5 -3 NULL Int64

query IIIT
SELECT ceil(CAST(5 AS INT)), ceil(-CAST(3 AS INT)), ceil(CAST(NULL AS INT)), arrow_typeof(ceil(CAST(5 AS INT)));
----
5 -3 NULL Int64

query IIIT
SELECT ceil(CAST(5 AS BIGINT)), ceil(-CAST(3 AS BIGINT)), ceil(CAST(NULL AS BIGINT)), arrow_typeof(ceil(CAST(5 AS BIGINT)));
----
5 -3 NULL Int64

# Scalar input: decimal128 with scale > 0 returns decimal with scale 0
# ceil(1.50) = 2, ceil(-1.50) = -1, ceil(1.00) = 1
query RRRT
SELECT ceil(CAST(1.50 AS DECIMAL(10, 2))), ceil(-CAST(1.50 AS DECIMAL(10, 2))), ceil(CAST(1.00 AS DECIMAL(10, 2))), arrow_typeof(ceil(CAST(1.50 AS DECIMAL(10, 2))));
----
2 -1 1 Decimal128(9, 0)

# ceil(-0.1) = 0 (smallest positive decimal rounds up to 0 for negatives)
query RRT
SELECT ceil(-CAST(0.1 AS DECIMAL(3, 1))), ceil(CAST(NULL AS DECIMAL(10, 2))), arrow_typeof(ceil(-CAST(0.1 AS DECIMAL(3, 1))));
----
0 NULL Decimal128(3, 0)

# ceil(3.1411) = 4
query RT
SELECT ceil(CAST(3.1411 AS DECIMAL(5, 4))), arrow_typeof(ceil(CAST(3.1411 AS DECIMAL(5, 4))));
----
4 Decimal128(2, 0)

# Scalar input: decimal128 with scale = 0 passes through unchanged
query RRRT
SELECT ceil(CAST(5 AS DECIMAL(10, 0))), ceil(-CAST(3 AS DECIMAL(10, 0))), ceil(CAST(NULL AS DECIMAL(10, 0))), arrow_typeof(ceil(CAST(5 AS DECIMAL(10, 0))));
----
5 -3 NULL Decimal128(10, 0)

# Array input: float64
query I
SELECT ceil(a) FROM (VALUES (CAST(125.2345 AS DOUBLE)), (CAST(15.0001 AS DOUBLE)), (CAST(0.1 AS DOUBLE)), (-CAST(0.9 AS DOUBLE)), (-CAST(1.1 AS DOUBLE)), (CAST(123.0 AS DOUBLE)), (CAST(NULL AS DOUBLE))) AS t(a);
----
126
16
1
0
-1
123
NULL

# Array input: float32
query I
SELECT ceil(a) FROM (VALUES (CAST(125.2345 AS FLOAT)), (CAST(15.0001 AS FLOAT)), (CAST(0.1 AS FLOAT)), (-CAST(0.9 AS FLOAT)), (-CAST(1.1 AS FLOAT)), (CAST(123.0 AS FLOAT)), (CAST(NULL AS FLOAT))) AS t(a);
----
126
16
1
0
-1
123
NULL

# Array input: integers
query I
SELECT ceil(a) FROM (VALUES (CAST(5 AS INT)), (-CAST(3 AS INT)), (CAST(NULL AS INT))) AS t(a);
----
5
-3
NULL

# Array input: decimal128 with scale > 0
query R
SELECT ceil(a) FROM (VALUES (CAST(1.50 AS DECIMAL(10, 2))), (-CAST(1.50 AS DECIMAL(10, 2))), (CAST(1.00 AS DECIMAL(10, 2))), (CAST(NULL AS DECIMAL(10, 2)))) AS t(a);
----
2
-1
1
NULL
