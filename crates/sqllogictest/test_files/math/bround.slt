## Original Query: SELECT bround(2.5, 0);
## PySpark 3.5.5 Result: {'bround(2.5, 0)': Decimal('2'), 'typeof(bround(2.5, 0))': 'decimal(2,0)', 'typeof(2.5)': 'decimal(2,1)', 'typeof(0)': 'int'}
# The scale is a constant expression, not a literal. The planner computes the decimal
# result type from literal arguments only, so without constant folding the result keeps
# the input scale. This is a limitation of planning in DataFusion, not of
# `invoke_with_args`: a caller that builds the physical expression, such as Comet, passes
# the result type itself.
skipif evaluate
query RT
SELECT bround(CAST(2.5 AS decimal(2,1)), CAST(0 AS int)), arrow_typeof(bround(CAST(2.5 AS decimal(2,1)), CAST(0 AS int)));
----
2 Decimal128(2, 0)

## Original Query: SELECT bround(25, -1);
## PySpark 3.5.5 Result: {'bround(25, -1)': 20, 'typeof(bround(25, -1))': 'int', 'typeof(25)': 'int', 'typeof(-1)': 'int'}
query IT
SELECT bround(CAST(25 AS int), -1), arrow_typeof(bround(CAST(25 AS int), -1));
----
20 Int32

# Default scale is 0
query RR
SELECT bround(CAST(2.5 AS double)), bround(CAST(3.5 AS double));
----
2 4

# Integer ties round to the even neighbour
query IIIIII
SELECT bround(25, -1), bround(35, -1), bround(-25, -1), bround(-35, -1), bround(26, -1), bround(-24, -1);
----
20 40 -20 -40 30 -20

# Integer types keep their type
query IIITTT
SELECT bround(CAST(525 AS smallint), -1), bround(CAST(525 AS bigint), -3), bround(CAST(25 AS tinyint), -2),
  arrow_typeof(bround(CAST(525 AS smallint), -1)), arrow_typeof(bround(CAST(525 AS bigint), -3)), arrow_typeof(bround(CAST(25 AS tinyint), -2));
----
520 1000 0 Int16 Int64 Int8

# Non-negative scale leaves integers unchanged, very negative scale gives 0
query III
SELECT bround(42, 2), bround(CAST(25 AS tinyint), -3), bround(9223372036854775807, -40);
----
42 0 0

# Integer overflow wraps with ANSI mode off
query IIII
SELECT bround(CAST(2147483647 AS INT), -1), bround(CAST(-128 AS TINYINT), -1), bround(CAST(32767 AS SMALLINT), -1),
  bround(CAST(-9223372036854775808 AS BIGINT), -1);
----
-2147483646 126 -32766 9223372036854775806

# Decimal ties and result types
query RRRR
SELECT bround(CAST(45.00 AS decimal(4,2)), -1), bround(-CAST(0.35 AS decimal(2,2)), 1), bround(CAST(0.125 AS decimal(4,3)), 2),
  bround(CAST(1.25 AS decimal(3,2)), 5);
----
40 -0.4 0.12 1.25

query TTTT
SELECT arrow_typeof(bround(CAST(45.00 AS decimal(4,2)), -1)), arrow_typeof(bround(-CAST(0.35 AS decimal(2,2)), 1)),
  arrow_typeof(bround(CAST(0.125 AS decimal(4,3)), 2)), arrow_typeof(bround(CAST(1.25 AS decimal(3,2)), 5));
----
Decimal128(3, 0) Decimal128(2, 1) Decimal128(4, 2) Decimal128(4, 2)

query RT
SELECT bround(CAST(5.5 AS decimal(2,1)), -3), arrow_typeof(bround(CAST(5.5 AS decimal(2,1)), -3));
----
0 Decimal128(4, 0)

query RT
SELECT bround(CAST('99999999999999999999999999999999999999' AS decimal(38,0)), 0),
  arrow_typeof(bround(CAST('99999999999999999999999999999999999999' AS decimal(38,0)), 0));
----
99999999999999999999999999999999999999 Decimal128(38, 0)

# A result that needs more than 38 digits fails
query error NUMERIC_VALUE_OUT_OF_RANGE
SELECT bround(CAST('99999999999999999999999999999999999999' AS decimal(38,0)), -1);

# Floating-point ties round the shortest decimal representation, like Spark
query RRRRRR
SELECT bround(CAST(0.5 AS double), 0), bround(CAST(1.5 AS double), 0), bround(-CAST(2.5 AS double), 0), bround(-CAST(0.35 AS double), 1),
  bround(CAST(0.125 AS double), 2), bround(CAST(2.675 AS double), 2);
----
0 2 -2 -0.4 0.12 2.68

query RRRR
SELECT bround(CAST(25.0 AS double), -1), bround(CAST(35.0 AS double), -1), bround(CAST(123.456 AS double), 400), bround(CAST(123.456 AS double), -400);
----
20 40 123.456 0

# Negative zero becomes zero
query T
SELECT CAST(bround(-CAST(0.4 AS double), 0) AS VARCHAR);
----
0.0

# FLOAT keeps its type and is widened to DOUBLE first (3.1414999961853027)
query RRT
SELECT bround(CAST(3.1415 AS float), 4), bround(CAST(3.1415 AS float), 3), arrow_typeof(bround(CAST(3.1415 AS float), 4));
----
3.1415 3.141 Float32

query RRR
SELECT bround(CAST('NaN' AS double), 1), bround(CAST('Infinity' AS double), 1), bround(CAST('-Infinity' AS double), 1);
----
NaN Infinity -Infinity

# NULL input
query IRR
SELECT bround(CAST(NULL AS int), -1), bround(CAST(NULL AS double), 1), bround(CAST(2.5 AS double), NULL);
----
NULL NULL NULL

# Column input
query R
SELECT bround(column1, 0) FROM VALUES (CAST(0.5 AS double)), (CAST(1.5 AS double)), (CAST(2.5 AS double)), (-CAST(2.5 AS double)), (CAST(NULL AS double));
----
0
2
2
-2
NULL

query I
SELECT bround(column1, -1) FROM VALUES (15), (25), (-15), (-25), (NULL);
----
20
20
-20
-20
NULL

query R
SELECT bround(column1, 1) FROM VALUES (CAST(0.25 AS decimal(3,2))), (CAST(0.35 AS decimal(3,2))), (-CAST(0.25 AS decimal(3,2))), (CAST(NULL AS decimal(3,2)));
----
0.2
0.4
-0.2
NULL

# A constant scale that is not a bare literal
# The scale is a constant expression, not a literal. The planner computes the decimal
# result type from literal arguments only, so without constant folding the result keeps
# the input scale. This is a limitation of planning in DataFusion, not of
# `invoke_with_args`: a caller that builds the physical expression, such as Comet, passes
# the result type itself.
skipif evaluate
query RRR
SELECT bround(CAST(2.25 AS decimal(3,2)), CAST(1 AS bigint)) AS a, bround(CAST(2.25 AS decimal(3,2)), 1 + 0) AS b, bround(CAST(2.25 AS decimal(3,2)), CAST(1 AS INT)) AS c;
----
2.2 2.2 2.2

# The result type needs the scale, so it relies on the optimizer folding it first
# The scale is a constant expression, not a literal. The planner computes the decimal
# result type from literal arguments only, so without constant folding the result keeps
# the input scale. This is a limitation of planning in DataFusion, not of
# `invoke_with_args`: a caller that builds the physical expression, such as Comet, passes
# the result type itself.
skipif evaluate
query TTTT
SELECT arrow_typeof(bround(CAST(2.25 AS decimal(3,2)), CAST(1 AS bigint))) AS a, arrow_typeof(bround(CAST(2.25 AS decimal(3,2)), 1 + 0)) AS b,
  arrow_typeof(bround(CAST(2.25 AS decimal(3,2)), CAST(1 AS INT))) AS c, arrow_typeof(bround(column1, CAST(1 AS bigint))) AS d
FROM VALUES (CAST(2.25 AS decimal(3,2)));
----
Decimal128(3, 1) Decimal128(3, 1) Decimal128(3, 1) Decimal128(3, 1)

# Decimal precision is capped at 38 and narrow decimals are widened
query RT
SELECT bround(arrow_cast(999999999, 'Decimal32(9,0)'), -1), arrow_typeof(bround(arrow_cast(999999999, 'Decimal32(9,0)'), -1));
----
1000000000 Decimal128(10, 0)

query error bround supports decimals up to precision 38, got Decimal256
SELECT bround(arrow_cast(1, 'Decimal256(50,0)'), 0);

# A STRING is cast to DOUBLE, a malformed one is NULL with ANSI mode off
query RTR
SELECT bround('2.5', 0), arrow_typeof(bround('2.5', 0)), bround('abc', 0);
----
2 Float64 NULL

query RRR
SELECT bround(column1, 1), bround(arrow_cast(column1, 'LargeUtf8'), 1), bround(arrow_cast(column1, 'Utf8View'), 1)
FROM VALUES ('0.25'), ('abc'), (NULL);
----
0.2 0.2 0.2
NULL NULL NULL
NULL NULL NULL

# Dictionary-encoded inputs use their value type
query IT
SELECT bround(arrow_cast(arrow_cast(25, 'Int32'), 'Dictionary(Int32, Int32)'), -1),
  arrow_typeof(bround(arrow_cast(arrow_cast(25, 'Int32'), 'Dictionary(Int32, Int32)'), -1));
----
20 Int32

# A cast scale on a decimal column, used in a filter
# The scale is a constant expression, not a literal. The planner computes the decimal
# result type from literal arguments only, so without constant folding the result keeps
# the input scale. This is a limitation of planning in DataFusion, not of
# `invoke_with_args`: a caller that builds the physical expression, such as Comet, passes
# the result type itself.
skipif evaluate
query R
SELECT r FROM (SELECT bround(column1, CAST(1 AS bigint)) AS r FROM VALUES (CAST(2.25 AS decimal(3,2))), (CAST(2.35 AS decimal(3,2)))) WHERE r > 2.3;
----
2.4

# A NULL literal is treated as DOUBLE
query RT
SELECT bround(NULL, 1), arrow_typeof(bround(NULL, 1));
----
NULL Float64

# Types Spark does not have are rejected
query error bround requires a numeric or string input, got UInt8
SELECT bround(arrow_cast(25, 'UInt8'), -1);

query error bround requires a numeric or string input, got Float16
SELECT bround(arrow_cast(2.5, 'Float16'), 0);

# A decimal input needs a constant scale
query error bround requires a constant scale
SELECT bround(column1, column2) FROM VALUES (CAST(2.5 AS decimal(2,1)), 0);

# Integer overflow fails with ANSI mode on
statement ok
set datafusion.execution.enable_ansi_mode = true;

query error ARITHMETIC_OVERFLOW
SELECT bround(CAST(2147483647 AS INT), -1);

query error ARITHMETIC_OVERFLOW
SELECT bround(CAST(-128 AS TINYINT), -1);

query error Cannot cast string 'abc' to value of Float64 type
SELECT bround('abc', 0);

query I
SELECT bround(25, -1);
----
20

statement ok
set datafusion.execution.enable_ansi_mode = false;
