## Original Query: SELECT positive(1);
## PySpark 3.5.5 Result: {'(+ 1)': 1, 'typeof((+ 1))': 'int', 'typeof(1)': 'int'}
query IT
SELECT positive(1::int), arrow_typeof(positive(1::int));
----
1 Int32

# Integers keep their type and value, including the minimum value
query IIII
SELECT positive((-128)::tinyint), positive((-32768)::smallint), positive((-2147483648)::int), positive(CAST('-9223372036854775808' AS BIGINT));
----
-128 -32768 -2147483648 -9223372036854775808

query TTTT
SELECT arrow_typeof(positive(1::tinyint)) AS a, arrow_typeof(positive(1::smallint)) AS b, arrow_typeof(positive(1::int)) AS c, arrow_typeof(positive(1::bigint)) AS d;
----
Int8 Int16 Int32 Int64

# Floating point values are returned unchanged
query RRRR
SELECT positive(1.5::float), positive(CAST('NaN' AS DOUBLE)), positive(CAST('Infinity' AS DOUBLE)), positive(CAST('-Infinity' AS DOUBLE));
----
1.5 NaN Infinity -Infinity

query T
SELECT arrow_typeof(positive(1.5::float));
----
Float32

# The sign of -0.0 is kept: pow(-0.0, -1.0) is -Infinity
query R
SELECT pow(positive(CAST('-0.0' AS DOUBLE)), -1.0);
----
-Infinity

# DECIMAL keeps its precision and scale
query RT
SELECT positive(CAST(-1.11 AS DECIMAL(3, 2))), arrow_typeof(positive(CAST(-1.11 AS DECIMAL(3, 2))));
----
-1.11 Decimal128(3, 2)

# A STRING is cast to DOUBLE
query RT
SELECT positive('-1.11'), arrow_typeof(positive('-1.11'));
----
-1.11 Float64

# A malformed STRING is NULL when ANSI mode is off
query R
SELECT positive('abc');
----
NULL

# Intervals are returned unchanged
query BT
SELECT positive(make_dt_interval(1::int, 2::int)) = make_dt_interval(1::int, 2::int), arrow_typeof(positive(make_dt_interval(1::int, 2::int)));
----
true Duration(µs)

query BT
SELECT positive(arrow_cast('1 year 2 months', 'Interval(YearMonth)')) = arrow_cast('1 year 2 months', 'Interval(YearMonth)'), arrow_typeof(positive(arrow_cast('1 year 2 months', 'Interval(YearMonth)')));
----
true Interval(YearMonth)

# NULL input
query R
SELECT positive(NULL);
----
NULL

query IT
SELECT positive(NULL::int), arrow_typeof(positive(NULL::int));
----
NULL Int32

# Column input
query I
SELECT positive(column1)
FROM VALUES
(1::int),
((-2)::int),
(NULL::int);
----
1
-2
NULL

# Every interval unit is returned unchanged
query BBT
SELECT positive(arrow_cast('1 day 2 hours', 'Interval(DayTime)')) = arrow_cast('1 day 2 hours', 'Interval(DayTime)'),
  positive(arrow_cast('1 month 2 days 3 nanoseconds', 'Interval(MonthDayNano)')) = arrow_cast('1 month 2 days 3 nanoseconds', 'Interval(MonthDayNano)'),
  arrow_typeof(positive(arrow_cast('1 month 2 days 3 nanoseconds', 'Interval(MonthDayNano)')));
----
true true Interval(MonthDayNano)

# STRING columns of every string type, with valid, malformed and NULL rows
query RRR
SELECT positive(column1), positive(arrow_cast(column1, 'LargeUtf8')), positive(arrow_cast(column1, 'Utf8View'))
FROM VALUES ('-1.5'), ('abc'), (NULL);
----
-1.5 -1.5 -1.5
NULL NULL NULL
NULL NULL NULL

# Dictionary-encoded inputs use their value type
query RTIT
SELECT positive(arrow_cast('-1.5', 'Dictionary(Int32, Utf8)')), arrow_typeof(positive(arrow_cast('-1.5', 'Dictionary(Int32, Utf8)'))),
  positive(arrow_cast(arrow_cast(-2, 'Int64'), 'Dictionary(Int32, Int64)')), arrow_typeof(positive(arrow_cast(arrow_cast(-2, 'Int64'), 'Dictionary(Int32, Int64)')));
----
-1.5 Float64 -2 Int64

# Known difference: Spark parses strings with Java's Double.parseDouble, which accepts a type
# suffix and hex floats, so Spark returns 1.5 and 8.0. Arrow's cast returns NULL for both.
# query RR
# SELECT positive('1.5d'), positive('0x1p3');
# ----
# 1.5 8.0

# The function is removed from the plan, so it does not block pushdown
statement ok
set datafusion.explain.logical_plan_only = true;

# The plan is only rewritten when simplify runs.
onlyif simplify
query TT
EXPLAIN SELECT positive(column1) FROM VALUES (1);
----
logical_plan
01)Projection: column1 AS positive(column1)
02)--Values: (Int64(1))

# The plan is only rewritten when simplify runs.
onlyif simplify
query TT
EXPLAIN SELECT positive(column1) FROM VALUES ('-1.5');
----
logical_plan
01)Projection: TRY_CAST(column1 AS Float64) AS positive(column1)
02)--Values: (Utf8("-1.5"))

statement ok
set datafusion.explain.logical_plan_only = false;

# DATE, TIMESTAMP, BOOLEAN and BINARY are rejected
query error positive requires a numeric, interval or string input, got Date32
SELECT positive('1999-01-01'::date);

query error positive requires a numeric, interval or string input, got Timestamp
SELECT positive('1999-01-01 00:00:00'::timestamp);

query error positive requires a numeric, interval or string input, got Boolean
SELECT positive(true);

query error positive requires a numeric, interval or string input, got Binary
SELECT positive(X'01');

# Types Spark does not have are rejected
query error positive requires a numeric, interval or string input, got UInt8
SELECT positive(arrow_cast(1, 'UInt8'));

query error positive requires a numeric, interval or string input, got Float16
SELECT positive(arrow_cast(1, 'Float16'));

query error positive requires a numeric, interval or string input, got Duration
SELECT positive(arrow_cast(1, 'Duration(Second)'));

# A malformed STRING raises an error when ANSI mode is on
statement ok
set datafusion.execution.enable_ansi_mode = true;

query R
SELECT positive('-1.11');
----
-1.11

query error Cannot cast string 'abc' to value of Float64 type
SELECT positive('abc');

query error Cannot cast string 'abc' to value of Float64 type
SELECT positive(arrow_cast(column1, 'Utf8View')) FROM VALUES ('-1.5'), ('abc');

statement ok
set datafusion.execution.enable_ansi_mode = false;
