# Expected values verified against Apache Spark 4.2.0.

## Examples from Spark's documentation

query B
SELECT contains(CAST('Spark SQL' AS string), CAST('Spark' AS string));
----
true

query B
SELECT contains(CAST('Spark SQL' AS string), CAST('SPARK' AS string));
----
false

query B
SELECT contains(CAST('Spark SQL' AS string), NULL);
----
NULL

query B
SELECT contains(X'537061726B2053514C', X'537061726B');
----
true

## NULL handling

query BBB
SELECT contains(NULL, CAST('a' AS string)), contains(NULL, NULL), contains(X'537061726B', NULL);
----
NULL NULL NULL

## Empty strings: an empty needle is found everywhere

query BBBBB
SELECT contains(CAST('' AS string), CAST('' AS string)), contains(CAST('abc' AS string), CAST('' AS string)), contains(CAST('' AS string), CAST('a' AS string)), contains(X'', X''), contains(X'01', X'');
----
true true false true true

## Case sensitivity, multi-byte characters and needles longer than the haystack

query BBBBB
SELECT contains(CAST('a' AS string), CAST('A' AS string)), contains(CAST('héllo wörld' AS string), CAST('ö' AS string)), contains(CAST('日本語' AS string), CAST('本' AS string)), contains(CAST('abc' AS string), CAST('abcd' AS string)), contains(CAST('aaa' AS string), CAST('aa' AS string));
----
false true true false true

## Binary: byte-level match, including bytes that are not valid UTF-8

query BB
SELECT contains(X'00FF01', X'FF'), contains(X'00FF01', X'FE');
----
true false

query B
SELECT contains(X'C328', X'28');
----
true

## Mixed string and binary: Spark casts the binary to a string

query BB
SELECT contains(X'537061726B', CAST('Spa' AS string)), contains(CAST('Spark' AS string), X'537061');
----
true true

## Integer, boolean and date arguments are cast to a string

query BBB
SELECT contains(12345, 23), contains(12345, CAST('34' AS string)), contains(true, CAST('ru' AS string));
----
true true true

query B
SELECT contains(DATE '2024-01-15', CAST('-01-' AS string));
----
true

## Column inputs

query B
SELECT contains(s, p) FROM VALUES ('hello world', 'world'), ('hello', ''), (NULL, 'a'), ('abc', NULL), ('abc', 'd') AS t(s, p);
----
true
true
NULL
NULL
false

# Column haystack, literal needle
query B
SELECT contains(s, 'o') FROM VALUES ('hello'), ('abc'), (NULL), ('') AS t(s);
----
true
false
NULL
false

# Literal haystack, column needle
query B
SELECT contains(CAST('hello world' AS string), p) FROM VALUES ('hello'), ('xyz'), (NULL), ('') AS t(p);
----
true
false
NULL
true

# Binary columns
query B
SELECT contains(b, X'FF') FROM VALUES (X'00FF01'), (X'0102'), (NULL), (X'') AS t(b);
----
true
false
NULL
false

## Errors

statement error contains function requires 2 arguments
SELECT contains(CAST('abc' AS string));

statement error Spark `contains` function expects STRING or BINARY arguments
SELECT contains(array('a'), CAST('a' AS string));

# Spark casts floating-point, decimal and timestamp arguments to a string, which
# this version cannot do yet, so it rejects them.
# https://github.com/apache/datafusion-spark/issues/347
# xfail spark: contains rejects a DOUBLE argument that Spark casts to a string (https://github.com/apache/datafusion-spark/issues/347)
statement error Spark `contains` function expects STRING or BINARY arguments, got Float64
SELECT contains(CAST(1.5 AS double), '.');

# Spark 4.2.0 returns true for these in both ANSI modes
# query BB
# SELECT contains(1.5::double, '.'), contains(TIMESTAMP '2024-01-01 00:00:00', ' ');
# ----
# true true

# Spark 4.2.0 casts a DECIMAL to a string differently in the two ANSI modes. With ANSI
# mode off it gives '1.0E-7' and with it on it gives '0.00000010'.
# query B
# SELECT contains(CAST(0.0000001 AS DECIMAL(10,8)), 'E');
# ----
# true
#
# statement ok
# set datafusion.execution.enable_ansi_mode = true;
#
# query B
# SELECT contains(CAST(0.0000001 AS DECIMAL(10,8)), 'E');
# ----
# false
#
# statement ok
# set datafusion.execution.enable_ansi_mode = false;

## Arrow string and binary variants

query BBB
SELECT contains(arrow_cast('Spark SQL', 'LargeUtf8'), CAST('SQL' AS string)), contains(CAST('Spark SQL' AS STRING), CAST('k S' AS STRING)), contains(CAST('Spark SQL' AS STRING), arrow_cast('x', 'LargeUtf8'));
----
true true false

query BBB
SELECT contains(arrow_cast(X'00FF01', 'LargeBinary'), X'FF01'), contains(arrow_cast(X'00FF01', 'BinaryView'), X'00'), contains(arrow_cast(X'00FF01', 'BinaryView'), CAST('a' AS string));
----
true true false

query B
SELECT contains(CAST(s AS STRING), arrow_cast(p, 'LargeUtf8')) FROM VALUES ('hello world', 'world'), ('hello', ''), (NULL, 'a'), ('abc', NULL), ('abc', 'd') AS t(s, p);
----
true
true
NULL
NULL
false
