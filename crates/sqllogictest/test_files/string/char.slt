query T
SELECT char(CAST(65 AS INT));
----
A

query T
SELECT char(CAST(321 AS INT));
----
A

query T
SELECT char(CAST(NULL AS INT));
----
NULL

query T
SELECT char(a) FROM (VALUES (-CAST(1 AS INT)), (CAST(0 AS INT)), (CAST(65 AS INT)), (CAST(321 AS INT))) AS t(a);
----
(empty)
\0
A
A
