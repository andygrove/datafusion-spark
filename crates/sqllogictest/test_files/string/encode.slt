# UTF-8 encoding
query ?
SELECT encode(CAST('Spark SQL' AS string), CAST('utf-8' AS string));
----
537061726b2053514c

# US-ASCII encoding
query ?
SELECT encode(CAST('Hello' AS string), CAST('us-ascii' AS string));
----
48656c6c6f

# ISO-8859-1 encoding (ï = 0xEF in ISO-8859-1)
query ?
SELECT encode(CAST('naïve' AS string), CAST('iso-8859-1' AS string));
----
6e61ef7665

# UTF-16BE encoding
query ?
SELECT encode(CAST('AB' AS string), CAST('utf-16be' AS string));
----
00410042

# UTF-16LE encoding
query ?
SELECT encode(CAST('AB' AS string), CAST('utf-16le' AS string));
----
41004200

# UTF-16 with BOM (FEFF prefix followed by UTF-16BE bytes)
query ?
SELECT encode(CAST('Spark SQL' AS string), CAST('utf-16' AS string));
----
feff0053007000610072006b002000530051004c

# UTF-32BE encoding (alias rejected in Spark 4 strict mode)
# xfail spark<4.0: intended: Spark 3.5 accepts any Java charset name, which Spark 4 allows only with spark.sql.legacy.javaCharsets
statement error INVALID_PARAMETER_VALUE\.CHARSET
SELECT encode(CAST('A' AS string), CAST('utf-32be' AS string));

# UTF-32LE encoding (alias rejected in Spark 4 strict mode)
# xfail spark<4.0: intended: Spark 3.5 accepts any Java charset name, which Spark 4 allows only with spark.sql.legacy.javaCharsets
statement error INVALID_PARAMETER_VALUE\.CHARSET
SELECT encode(CAST('AB' AS string), CAST('utf-32le' AS string));

# UTF-32 (Spark 3.5 / 4.1: no BOM, identical to UTF-32BE)
query ?
SELECT encode(CAST('A' AS string), CAST('utf-32' AS string));
----
00000041

# Case-insensitive charset
query ?
SELECT encode(CAST('hello' AS string), CAST('Utf-8' AS string));
----
68656c6c6f

# US-ASCII: unmappable characters fail in Spark 4 strict mode
# xfail spark<4.0: intended: Spark 3.5 replaces unmappable characters with `?`, which Spark 4 does only with spark.sql.legacy.codingErrorAction
statement error MALFORMED_CHARACTER_CODING
SELECT encode(CAST('é' AS string), CAST('us-ascii' AS string));

# ISO-8859-1: code points above U+00FF fail in Spark 4 strict mode (Ā is U+0100)
# xfail spark<4.0: intended: Spark 3.5 replaces unmappable characters with `?`, which Spark 4 does only with spark.sql.legacy.codingErrorAction
statement error MALFORMED_CHARACTER_CODING
SELECT encode(CAST('Ā' AS string), CAST('iso-8859-1' AS string));

# Multi-byte input (emoji 😀 = U+1F600) across charsets
query ?
SELECT encode(CAST('😀' AS string), CAST('utf-8' AS string));
----
f09f9880

query ?
SELECT encode(CAST('😀' AS string), CAST('utf-16be' AS string));
----
d83dde00

query ?
SELECT encode(CAST('😀' AS string), CAST('utf-16le' AS string));
----
3dd800de

query ?
SELECT encode(CAST('😀' AS string), CAST('utf-16' AS string));
----
feffd83dde00

# xfail spark<4.0: intended: Spark 3.5 accepts any Java charset name, which Spark 4 allows only with spark.sql.legacy.javaCharsets
statement error INVALID_PARAMETER_VALUE\.CHARSET
SELECT encode(CAST('😀' AS string), CAST('utf-32be' AS string));

# xfail spark<4.0: intended: Spark 3.5 accepts any Java charset name, which Spark 4 allows only with spark.sql.legacy.javaCharsets
statement error INVALID_PARAMETER_VALUE\.CHARSET
SELECT encode(CAST('😀' AS string), CAST('utf-32le' AS string));

query ?
SELECT encode(CAST('😀' AS string), CAST('utf-32' AS string));
----
0001f600

# Utf8View column input
query ?
SELECT encode(CAST(s AS STRING), CAST('utf-8' AS string)) FROM (VALUES (CAST('foo' AS string)), (CAST('bar' AS string))) AS t(s);
----
666f6f
626172

# Binary input is decoded as UTF-8 (lossily), then re-encoded with the charset
query ?
SELECT encode(CAST('Hello' AS BINARY), CAST('utf-8' AS string));
----
48656c6c6f

query ?
SELECT encode(arrow_cast('Hello', 'LargeBinary'), CAST('utf-8' AS string));
----
48656c6c6f

query ?
SELECT encode(arrow_cast('Hello', 'BinaryView'), CAST('utf-8' AS string));
----
48656c6c6f

# Binary input with invalid UTF-8 bytes: each invalid byte becomes U+FFFD (ef bf bd).
# Bytes FE and FF are not valid UTF-8 and are replaced; 00 61 00 73 decode as NUL a NUL s.
query ?
SELECT encode(X'FEFF00610073', CAST('utf-8' AS string));
----
efbfbdefbfbd00610073

# Strict mode: binary input with invalid UTF-8 byte 0xFF becomes U+FFFD, which cannot be encoded in US-ASCII
# xfail spark<4.0: intended: Spark 3.5 replaces unmappable characters with `?`, which Spark 4 does only with spark.sql.legacy.codingErrorAction
query error \[MALFORMED_CHARACTER_CODING\] Invalid value found when performing `encode` with us-ascii SQLSTATE: 22000
SELECT encode(X'ff', CAST('us-ascii' AS string));

# NULL input
query ?
SELECT encode(CAST(NULL AS string), CAST('utf-8' AS string));
----
NULL

# NULL input with invalid charset returns NULL (Spark NullIntolerant)
query ?
SELECT encode(CAST(NULL AS string), CAST('bogus' AS string));
----
NULL

# Column input where every value is NULL with invalid charset returns NULL
query ?
SELECT encode(a, CAST('bogus' AS string)) FROM VALUES (CAST(NULL AS STRING)) t(a);
----
NULL

# Empty input batch with invalid charset returns no rows without error
# xfail spark: intended: Spark raises only because it constant-folds encode('test', 'bogus'); an empty table gives no rows
query ?
SELECT encode(a, CAST('bogus' AS string)) FROM (SELECT CAST('test' AS string) AS a WHERE false);
----

# Empty string with invalid charset raises error
query error \[INVALID_PARAMETER_VALUE\.CHARSET\] The value of parameter\(s\) `charset` in `encode` is invalid: expects one of the iso-8859-1, us-ascii, utf-16, utf-16be, utf-16le, utf-32, utf-8, but got bogus\. SQLSTATE: 22023
SELECT encode(CAST('' AS string), CAST('bogus' AS string));

# Non-null value with invalid charset raises error
query error \[INVALID_PARAMETER_VALUE\.CHARSET\] The value of parameter\(s\) `charset` in `encode` is invalid: expects one of the iso-8859-1, us-ascii, utf-16, utf-16be, utf-16le, utf-32, utf-8, but got bogus\. SQLSTATE: 22023
SELECT encode(CAST('hello' AS string), CAST('bogus' AS string));

# Array input with NULLs
query ?
SELECT encode(s, CAST('utf-8' AS string)) FROM (VALUES (CAST('hello' AS string)), (CAST(NULL AS string)), (CAST('world' AS string))) AS t(s);
----
68656c6c6f
NULL
776f726c64

# NULL charset returns NULL (Spark is NullIntolerant)
query ?
SELECT encode(CAST('hello' AS string), CAST(NULL AS string));
----
NULL

# Charset varies per row, and a NULL charset yields NULL for that row
query ?
SELECT encode(a, b) FROM VALUES (X'0a', 'US-ASCII'), (X'deadbeef', NULL) AS t(a, b);
----
0a
NULL

# Per-row charsets: each row encoded with its own charset
query ?
SELECT encode(a, b) FROM VALUES (X'0a', 'US-ASCII'), (X'deadbeef', 'UTF-16be') AS t(a, b);
----
0a
07adfffdfffd

# Error: unsupported charset (strict Spark 4 rejects unknown charsets with INVALID_PARAMETER_VALUE.CHARSET)
statement error INVALID_PARAMETER_VALUE\.CHARSET
SELECT encode(CAST('hello' AS string), CAST('EBCDIC' AS string));

# Error: no arguments
statement error encode function requires 2 arguments
SELECT encode();
