## Original Query: SELECT try_to_binary('abc', 'utf-8');
## PySpark 3.5.5 Result: {'try_to_binary(abc, utf-8)': bytearray(b'abc'), 'typeof(try_to_binary(abc, utf-8))': 'binary', 'typeof(abc)': 'string', 'typeof(utf-8)': 'string'}
query ?
SELECT try_to_binary(CAST('abc' AS string), CAST('utf-8' AS string));
----
616263

## Original Query: select try_to_binary('a!', 'base64');
## PySpark 3.5.5 Result: {'try_to_binary(a!, base64)': None, 'typeof(try_to_binary(a!, base64))': 'binary', 'typeof(a!)': 'string', 'typeof(base64)': 'string'}
query ?
SELECT try_to_binary(CAST('a!' AS string), CAST('base64' AS string));
----
NULL

## Original Query: select try_to_binary('abc', 'invalidFormat');
## PySpark 3.5.5 Result: {'try_to_binary(abc, invalidFormat)': None, 'typeof(try_to_binary(abc, invalidFormat))': 'binary', 'typeof(abc)': 'string', 'typeof(invalidFormat)': 'string'}
query ?
SELECT try_to_binary(CAST('abc' AS string), CAST('invalidFormat' AS string));
----
NULL

# where the conversion succeeds, try_to_binary matches to_binary
query ?
SELECT try_to_binary(CAST('537061726b' AS string));
----
537061726b

query ?
SELECT try_to_binary(CAST('U3Bhcms=' AS string), CAST('base64' AS string));
----
537061726b

# an invalid value is NULL rather than an error
query ?
SELECT try_to_binary(CAST('zz' AS string), CAST('hex' AS string));
----
NULL

query ?
SELECT try_to_binary(CAST(NULL AS string), CAST('hex' AS string));
----
NULL

# in a column, only the offending row becomes NULL
query ?
SELECT try_to_binary(a, CAST('hex' AS string)) FROM (VALUES (CAST('4142' AS string)), ('zz')) AS t(a);
----
4142
NULL
