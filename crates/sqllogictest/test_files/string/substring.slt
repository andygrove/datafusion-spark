query T
SELECT substring(CAST('Spark SQL' AS string), CAST(0 AS int));
----
Spark SQL

query T
SELECT substring(CAST('Spark SQL' AS string), CAST(5 AS int));
----
k SQL

query T
SELECT substring(CAST('Spark SQL' AS string), CAST(3 AS int), CAST(1 AS int));
----
a

# Test negative start
query T
SELECT substring(CAST('Spark SQL' AS string), -CAST(3 AS int));
----
SQL

query T
SELECT substring(CAST('Spark SQL' AS string), -CAST(3 AS int), CAST(2 AS int));
----
SQ

# Negative start counts from the end: -3 is the first character of 'abc'
query T
SELECT substring(CAST('abc' AS string), -CAST(3 AS int), CAST(6 AS int));
----
abc

# Test length exceeding string length
query T
SELECT substring(CAST('Spark SQL' AS string), CAST(2 AS int), CAST(700 AS int));
----
park SQL

# Test start position beyond string length
query T
SELECT substring(CAST('Spark SQL' AS string), CAST(30 AS int));
----
(empty)

query T
SELECT substring(CAST('Spark SQL' AS string), -CAST(30 AS int));
----
Spark SQL

# Test negative length
query T
SELECT substring(CAST('Spark SQL' AS string), CAST(3 AS int), -CAST(1 AS int));
----
(empty)

query T
SELECT substring(CAST('Spark SQL' AS string), CAST(3 AS int), CAST(0 AS int));
----
(empty)

# Test unicode strings
query T
SELECT substring(CAST('joséésoj' AS string), CAST(5 AS int));
----
ésoj

query T
SELECT substring(CAST('joséésoj' AS string), CAST(5 AS int), CAST(2 AS int));
----
és

# NULL handling
query T
SELECT substring(CAST('Spark SQL' AS string), CAST(NULL AS int));
----
NULL

query T
SELECT substring(CAST(NULL AS string), CAST(5 AS int));
----
NULL

query T
SELECT substring(CAST(NULL AS string), CAST(3 AS int), CAST(1 AS int));
----
NULL

query T
SELECT substring(CAST('Spark SQL' AS string), CAST(NULL AS int), CAST(1 AS int));
----
NULL

query T
SELECT substring(CAST('Spark SQL' AS string), CAST(3 AS int), CAST(NULL AS int));
----
NULL

query T
SELECT substring(column1, column2)
FROM VALUES
(CAST('Spark SQL' AS string), CAST(0 AS int)),
(CAST('Spark SQL' AS string), CAST(5 AS int)),
(CAST('Spark SQL' AS string), -CAST(3 AS int)),
(CAST('Spark SQL' AS string), CAST(500 AS int)),
(CAST('Spark SQL' AS string), -CAST(300 AS int)),
(CAST(NULL AS string), CAST(5 AS int)),
(CAST('Spark SQL' AS string), CAST(NULL AS int));
----
Spark SQL
k SQL
SQL
(empty)
Spark SQL
NULL
NULL

query T
SELECT substring(column1, column2, column3)
FROM VALUES
(CAST('Spark SQL' AS string), -CAST(3 AS int), CAST(2 AS int)),
(CAST('Spark SQL' AS string), CAST(3 AS int), CAST(1 AS int)),
(CAST('Spark SQL' AS string), CAST(3 AS int), CAST(700 AS int)),
(CAST('Spark SQL' AS string), CAST(3 AS int), -CAST(1 AS int)),
(CAST('Spark SQL' AS string), CAST(3 AS int), CAST(0 AS int)),
(CAST('Spark SQL' AS string), CAST(300 AS int), CAST(3 AS int)),
(CAST('Spark SQL' AS string), -CAST(300 AS int), CAST(3 AS int)),
(CAST(NULL AS string), CAST(3 AS int), CAST(1 AS int)),
(CAST('Spark SQL' AS string), CAST(NULL AS int), CAST(1 AS int)),
(CAST('Spark SQL' AS string), CAST(3 AS int), CAST(NULL AS int));
----
SQ
a
ark SQL
(empty)
(empty)
(empty)
(empty)
NULL
NULL
NULL

# alias substr

query T
SELECT substr(CAST('Spark SQL' AS string), CAST(0 AS int));
----
Spark SQL

query T
SELECT substr(column1, column2)
FROM VALUES
(CAST('Spark SQL' AS string), CAST(0 AS int)),
(CAST('Spark SQL' AS string), CAST(5 AS int)),
(CAST('Spark SQL' AS string), -CAST(3 AS int)),
(CAST('Spark SQL' AS string), CAST(500 AS int)),
(CAST('Spark SQL' AS string), -CAST(300 AS int)),
(CAST(NULL AS string), CAST(5 AS int)),
(CAST('Spark SQL' AS string), CAST(NULL AS int));
----
Spark SQL
k SQL
SQL
(empty)
Spark SQL
NULL
NULL

