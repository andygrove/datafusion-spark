query T
SELECT substr(column1, -10, 3)
FROM VALUES
(CAST('abc' AS string))
----
(empty)

# ----------------------------------------------------------------------
# Binary / LargeBinary / BinaryView support
# ----------------------------------------------------------------------

# 'Spark SQL' bytes => 53 70 61 72 6b 20 53 51 4c
# byte 1..9 => 's' 'p' 'a' 'r' 'k' ' ' 'S' 'Q' 'L'

# Binary: basic substring with only pos
query ?
SELECT substring(CAST('Spark SQL' AS BINARY), CAST(5 AS int));
----
6b2053514c

# Binary: substring with pos and length
query ?
SELECT substring(CAST('Spark SQL' AS BINARY), CAST(3 AS int), CAST(1 AS int));
----
61

# Binary: zero pos is treated as 1
query ?
SELECT substring(CAST('Spark SQL' AS BINARY), CAST(0 AS int));
----
537061726b2053514c

# Binary: negative pos counts from the end
query ?
SELECT substring(CAST('Spark SQL' AS BINARY), -CAST(3 AS int));
----
53514c

query ?
SELECT substring(CAST('Spark SQL' AS BINARY), -CAST(3 AS int), CAST(2 AS int));
----
5351

# Binary: length exceeding input length
query ?
SELECT substring(CAST('Spark SQL' AS BINARY), CAST(2 AS int), CAST(700 AS int));
----
7061726b2053514c

# Binary: pos beyond end returns empty binary
query I
SELECT character_length(substring(CAST('Spark SQL' AS BINARY), CAST(30 AS int)));
----
0

# Binary: large negative pos returns the full value
query ?
SELECT substring(CAST('Spark SQL' AS BINARY), -CAST(30 AS int));
----
537061726b2053514c

# Binary: negative length returns empty binary
query I
SELECT character_length(substring(CAST('Spark SQL' AS BINARY), CAST(3 AS int), -CAST(1 AS int)));
----
0

# Binary: zero length returns empty binary
query I
SELECT character_length(substring(CAST('Spark SQL' AS BINARY), CAST(3 AS int), CAST(0 AS int)));
----
0

# Binary: NULL handling
query ?
SELECT substring(CAST('Spark SQL' AS BINARY), CAST(NULL AS int));
----
NULL

query ?
SELECT substring(CAST(NULL AS BINARY), CAST(5 AS int));
----
NULL

query ?
SELECT substring(CAST('Spark SQL' AS BINARY), CAST(NULL AS int), CAST(1 AS int));
----
NULL

query ?
SELECT substring(CAST('Spark SQL' AS BINARY), CAST(3 AS int), CAST(NULL AS int));
----
NULL

# Binary: return type matches input type
query ?T
SELECT substring(CAST('Spark SQL' AS BINARY), CAST(3 AS int), CAST(2 AS int)),
       arrow_typeof(substring(CAST('Spark SQL' AS BINARY), CAST(3 AS int), CAST(2 AS int)));
----
6172 Binary

# LargeBinary: return type is preserved
query ?T
SELECT substring(arrow_cast('Spark SQL', 'LargeBinary'), CAST(3 AS int), CAST(2 AS int)),
       arrow_typeof(substring(arrow_cast('Spark SQL', 'LargeBinary'), CAST(3 AS int), CAST(2 AS int)));
----
6172 LargeBinary

# BinaryView: return type is preserved
query ?T
SELECT substring(arrow_cast('Spark SQL', 'BinaryView'), CAST(3 AS int), CAST(2 AS int)),
       arrow_typeof(substring(arrow_cast('Spark SQL', 'BinaryView'), CAST(3 AS int), CAST(2 AS int)));
----
6172 BinaryView

# Binary with non-UTF-8 bytes: byte-level slicing is preserved
# X'ff00aabb1122' has 6 bytes and is typed as Binary by default
query ?
SELECT substring(X'ff00aabb1122', CAST(2 AS int), CAST(3 AS int));
----
00aabb

query ?
SELECT substring(X'ff00aabb1122', -CAST(2 AS int), CAST(2 AS int));
----
1122

# substr alias works with binary input
query ?
SELECT substr(CAST('Spark SQL' AS BINARY), CAST(5 AS int));
----
6b2053514c

query ?
SELECT substr(arrow_cast('Spark SQL', 'LargeBinary'), CAST(3 AS int), CAST(1 AS int));
----
61

# Array input (Binary column) produces per-row byte-level substrings.
# The second column is the byte length of the result so empty-binary
# rows remain unambiguous in the expected output.
query ?I
SELECT substring(column1, column2, column3),
       character_length(substring(column1, column2, column3))
FROM VALUES
(CAST('Spark SQL' AS BINARY), -CAST(3 AS int), CAST(2 AS int)),
(CAST('Spark SQL' AS BINARY), CAST(3 AS int), CAST(1 AS int)),
(CAST('Spark SQL' AS BINARY), CAST(3 AS int), CAST(700 AS int)),
(CAST('Spark SQL' AS BINARY), CAST(3 AS int), -CAST(1 AS int)),
(CAST('Spark SQL' AS BINARY), CAST(3 AS int), CAST(0 AS int)),
(CAST('Spark SQL' AS BINARY), CAST(300 AS int), CAST(3 AS int)),
(CAST('Spark SQL' AS BINARY), -CAST(300 AS int), CAST(3 AS int)),
(CAST(NULL AS BINARY), CAST(3 AS int), CAST(1 AS int)),
(CAST('Spark SQL' AS BINARY), CAST(NULL AS int), CAST(1 AS int)),
(CAST('Spark SQL' AS BINARY), CAST(3 AS int), CAST(NULL AS int));
----
5351 2
61 1
61726b2053514c 7
 0
 0
 0
 0
NULL NULL
NULL NULL
NULL NULL
