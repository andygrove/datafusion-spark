query I
SELECT find_in_set(CAST('ab' AS string), CAST('abc,b,ab,c,def' AS string));
----
3

query I
SELECT find_in_set(CAST('abc' AS string), CAST('abc,b,ab,c,def' AS string));
----
1

query I
SELECT find_in_set(CAST('def' AS string), CAST('abc,b,ab,c,def' AS string));
----
5

query I
SELECT find_in_set(CAST('xyz' AS string), CAST('abc,b,ab,c,def' AS string));
----
0

query I
SELECT find_in_set(CAST('a' AS string), CAST('abc,b,ab,c,def' AS string));
----
0

query I
SELECT find_in_set(CAST('abcd' AS string), CAST('abc,b,ab,c,def' AS string));
----
0

query I
SELECT find_in_set(CAST('Ab' AS string), CAST('abc,b,ab,c,def' AS string));
----
0

query I
SELECT find_in_set(CAST('d,ef' AS string), CAST('abc,b,ab,c,def' AS string));
----
0

query I
SELECT find_in_set(CAST('ab,' AS string), CAST('abc,b,ab,c,def' AS string));
----
0

# by definition a needle containing a comma is never found
query I
SELECT find_in_set(CAST(',' AS string), CAST('a,,b' AS string));
----
0

# a list with no comma is one element, so an empty list has one empty element
query I
SELECT find_in_set(CAST('' AS string), CAST('' AS string));
----
1

query I
SELECT find_in_set(CAST('a' AS string), CAST('' AS string));
----
0

# one comma delimits two empty elements, and the first match wins
query I
SELECT find_in_set(CAST('' AS string), CAST(',' AS string));
----
1

query I
SELECT find_in_set(CAST('' AS string), CAST('a,,b' AS string));
----
2

query I
SELECT find_in_set(CAST('' AS string), CAST(',abc,b,ab,c,def' AS string));
----
1

# a trailing comma adds a final empty element
query I
SELECT find_in_set(CAST('' AS string), CAST('abc,b,ab,c,def,' AS string));
----
6

query I
SELECT find_in_set(CAST('' AS string), CAST('abc,b,ab,c,def' AS string));
----
0

query I
SELECT find_in_set(CAST('' AS string), CAST('abc' AS string));
----
0

query I
SELECT find_in_set(CAST('ab' AS string), CAST(',,,ab,abc,b,ab,c,def' AS string));
----
4

query I
SELECT find_in_set(CAST('ab' AS string), CAST('ab,abc,b,ab,c,def' AS string));
----
1

query I
SELECT find_in_set(CAST('b' AS string), CAST('a, b' AS string));
----
0

query I
SELECT find_in_set(CAST(' b' AS string), CAST('a, b' AS string));
----
2

query I
SELECT find_in_set(CAST('大' AS string), CAST('test,大千,世,界X,大,千,世界' AS string));
----
5

query I
SELECT find_in_set(CAST('界x' AS string), CAST('test,大千,世,界X,大,千,世界' AS string));
----
0

query I
SELECT find_in_set(CAST('𝔸' AS string), CAST('a,𐐅,𝔸' AS string));
----
3

query I
SELECT find_in_set(CAST('🔥' AS string), CAST('a,Д,🔥' AS string));
----
3

query I
SELECT find_in_set(CAST(NULL AS string), CAST('abc,b,ab,c,def' AS string));
----
NULL

query I
SELECT find_in_set(CAST('ab' AS string), CAST(NULL AS string));
----
NULL

query I
SELECT find_in_set(CAST(NULL AS string), CAST(NULL AS string));
----
NULL

query I
SELECT find_in_set(a, CAST('abc,b,ab,c,def' AS string)) FROM (VALUES (CAST('abc' AS string)), (CAST('def' AS string)), (CAST('zzz' AS string)), (CAST('' AS string)), (CAST('d,ef' AS string)), (CAST(NULL AS string))) AS t(a);
----
1
5
0
0
0
NULL

query I
SELECT find_in_set(CAST('ab' AS string), a) FROM (VALUES (CAST('abc,b,ab,c,def' AS string)), (CAST('ab' AS string)), (CAST('' AS string)), (CAST(',ab' AS string)), (CAST(NULL AS string))) AS t(a);
----
3
1
0
2
NULL

query I
SELECT find_in_set(a, b) FROM (VALUES (CAST('ab' AS string), CAST('abc,b,ab,c,def' AS string)), (CAST('' AS string), CAST('a,,b' AS string)), (CAST('c' AS string), CAST('a,b' AS string)), (CAST('a,b' AS string), CAST('a,b' AS string)), (CAST(NULL AS string), CAST('a,b' AS string)), (CAST('a' AS string), CAST(NULL AS string))) AS t(a, b);
----
3
2
0
0
NULL
NULL

# 20 elements is past the size at which the set is looked up rather than scanned, and a5 repeats at 19
query I
SELECT find_in_set(a, CAST('a0,a1,a2,a3,a4,a5,a6,a7,a8,a9,a10,a11,a12,a13,a14,a15,a16,a17,a5,' AS string)) FROM (VALUES (CAST('a0' AS string)), (CAST('a17' AS string)), (CAST('a5' AS string)), (CAST('' AS string)), (CAST('zz' AS string)), (CAST(NULL AS string))) AS t(a);
----
1
18
6
20
0
NULL

query I
SELECT find_in_set(CAST('ab' AS STRING), CAST('abc,b,ab,c,def' AS STRING));
----
3

query I
SELECT find_in_set(CAST(a AS STRING), CAST('abc,b,ab,c,def' AS STRING)) FROM (VALUES (CAST('ab' AS string)), (CAST('' AS string)), (CAST(NULL AS string))) AS t(a);
----
3
0
NULL

query I
SELECT find_in_set(arrow_cast('ab', 'LargeUtf8'), arrow_cast('abc,b,ab,c,def', 'LargeUtf8'));
----
3

query I
SELECT find_in_set(arrow_cast(a, 'LargeUtf8'), arrow_cast('abc,b,ab,c,def', 'LargeUtf8')) FROM (VALUES (CAST('ab' AS string)), (CAST('' AS string)), (CAST(NULL AS string))) AS t(a);
----
3
0
NULL

# Spark implicitly casts both arguments to strings.
query II
SELECT find_in_set(CAST(2 AS INT), '1,2,3'), find_in_set('2', CAST(2 AS INT));
----
2 1

query I
SELECT find_in_set(a, 'false,true')
FROM (VALUES (true), (false), (CAST(NULL AS BOOLEAN))) AS t(a);
----
2
1
NULL

query I
SELECT find_in_set(X'62', 'a,b');
----
2

query I
SELECT find_in_set(DATE '2020-01-01', 'x,2020-01-01');
----
2

# xfail spark: timestamp-to-string casting differs (https://github.com/apache/datafusion-spark/issues/88).
query I
SELECT find_in_set(TIMESTAMP '2020-01-01 00:00:00', 'x,2020-01-01 00:00:00');
----
0

# xfail spark: double-to-string casting differs (https://github.com/apache/datafusion-spark/issues/88).
query I
SELECT find_in_set(CAST(1e20 AS DOUBLE), '1.0E20,100000000000000000000');
----
0

# xfail spark: binary-to-string casting differs (https://github.com/apache/datafusion-spark/issues/88).
statement error Encountered non UTF-8 data
SELECT find_in_set(X'FF', 'a,b');

query III
SELECT find_in_set(NULL, 'a'), find_in_set('a', NULL), find_in_set(NULL, NULL);
----
NULL NULL NULL

query I
SELECT find_in_set(arrow_cast(a, 'LargeUtf8'), arrow_cast(b, 'Utf8View'))
FROM (VALUES ('b', 'a,b'), ('界', 'a,界'), (CAST(NULL AS STRING), 'a,b')) AS t(a, b);
----
2
2
NULL

query I
SELECT find_in_set(arrow_cast(a, 'Dictionary(Int8, Utf8)'), b)
FROM (VALUES ('b', 'a,b'), ('a', 'a,a'), (CAST(NULL AS STRING), 'a,b')) AS t(a, b);
----
2
1
NULL

query T
SELECT arrow_typeof(find_in_set(arrow_cast('b', 'LargeUtf8'), 'a,b'));
----
Int32

query T rowsort
SELECT arrow_typeof(find_in_set(arrow_cast(a, 'LargeUtf8'), b))
FROM (VALUES ('b', 'a,b'), (CAST(NULL AS STRING), 'a,b')) AS t(a, b);
----
Int32
Int32

# xfail spark: collations are not supported yet (https://github.com/apache/datafusion-spark/issues/299).
statement error Unsupported ast node in sqltorel: Collate
SELECT find_in_set('B' COLLATE UTF8_LCASE, 'a,b');
