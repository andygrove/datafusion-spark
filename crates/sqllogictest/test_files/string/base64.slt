# `base64` has no `invoke_with_args` yet, so the records that call it are marked
# `skipif evaluate` until https://github.com/apache/datafusion-spark/issues/313 is fixed.

skipif evaluate
query T
SELECT base64(CAST('Spark SQL' AS string));
----
U3BhcmsgU1FM

skipif evaluate
query T
SELECT base64(CAST('Spark SQ' AS string));
----
U3BhcmsgU1E=

skipif evaluate
query T
SELECT base64(CAST('Spark S' AS string));
----
U3BhcmsgUw==

