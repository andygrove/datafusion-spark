Spark SQL
Spark SQ
Spark S
NULL

# Spark decodes with java.util.Base64.getMimeDecoder: padding is optional
# and bytes outside the base64 alphabet are skipped
query T
SELECT hex(unbase64(CAST('123' AS string)));
----
D76D

query T
SELECT hex(unbase64(CAST('123' AS bytea)));
----
D76D

query T
SELECT hex(unbase64(column1))
FROM VALUES
(CAST('12' AS string)),
(CAST('YQ' AS string)),
(CAST('YW Jj' AS string)),
(CAST('YWJj!!' AS string)),
(CAST('YWJj ZGVm' AS string)),
(CAST('!!!!' AS string)),
(CAST('' AS string)),
(CAST(NULL AS string));
----
D7
61
616263
616263
616263646566
(empty)
(empty)
NULL

query T?
SELECT arrow_typeof(unbase64(column1)), unbase64(column1)
FROM VALUES
(arrow_cast(X'59513D3D', 'FixedSizeBinary(4)')),
(arrow_cast(NULL, 'FixedSizeBinary(4)'));
----
Binary 61
Binary NULL

# a single dangling character does not carry a full byte
query error Failed to decode value using base64: Last unit does not have enough valid bits
SELECT unbase64(CAST('Y' AS string));

query error Failed to decode value using base64: Last unit does not have enough valid bits
SELECT unbase64(CAST('YWJjZ' AS bytea));

# padding must still be well formed
query error Failed to decode value using base64: Input byte array has wrong 4-byte ending unit
SELECT unbase64(CAST('YQ=' AS string));

query error Failed to decode value using base64: Input byte array has incorrect ending byte
SELECT unbase64(CAST('YQ==YQ==' AS string));

# xfail spark: unbase64 rejects an INT argument that Spark casts to a string (https://github.com/apache/datafusion-spark/issues/41)
query error Error during planning: Function 'unbase64' requires Binary, but received Int32 \(DataType: Int32\)
SELECT unbase64(CAST(12 AS integer));

# Utf8View, LargeUtf8, BinaryView and LargeBinary inputs, including NULLs
query T
SELECT arrow_cast(unbase64(CAST('U3BhcmsgU1FM' AS STRING)), 'Utf8');
----
Spark SQL

query T
SELECT arrow_cast(unbase64(arrow_cast('U3BhcmsgU1FM', 'LargeUtf8')), 'Utf8');
----
Spark SQL

query T
SELECT arrow_cast(unbase64(arrow_cast('U3BhcmsgU1FM', 'BinaryView')), 'Utf8');
----
Spark SQL

query T
SELECT arrow_cast(unbase64(arrow_cast('U3BhcmsgU1FM', 'LargeBinary')), 'Utf8');
----
Spark SQL

query TTTT
SELECT arrow_typeof(unbase64(CAST('YQ==' AS STRING))), arrow_typeof(unbase64(arrow_cast('YQ==', 'LargeUtf8'))), arrow_typeof(unbase64(arrow_cast('YQ==', 'BinaryView'))), arrow_typeof(unbase64(arrow_cast('YQ==', 'LargeBinary')));
----
Binary LargeBinary Binary LargeBinary

