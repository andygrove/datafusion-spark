query T
SELECT concat(space(CAST(1 AS INT)), 'Spark');
----
 Spark

query T
SELECT concat(space(CAST(5 AS INT)), 'Spark');
----
     Spark

query T
SELECT space(CAST(0 AS INT));
----
(empty)

query T
SELECT space(-CAST(1 AS INT));
----
(empty)

query T
SELECT space(NULL);
----
NULL

# An integer literal is BIGINT here and INT in Spark, where this works (https://github.com/apache/datafusion-spark/issues/97)
# xfail spark: An integer literal is BIGINT here and INT in Spark (https://github.com/apache/datafusion-spark/issues/97)
statement error Failed to coerce arguments to satisfy a call to 'space' function
SELECT space(2);
